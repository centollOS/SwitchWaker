# Build image of the Switch Mesa (scripts/switch/build_mesa.sh): the pinned devkitPro image of
# Containerfile.native/Containerfile.dawn plus the host tools Mesa 20.1's meson build needs
# (meson, flex, bison, mako). The devkitPro switch-mesa 20.1.0-5 recipe (pacman-packages
# switch/mesa/PKGBUILD) runs /opt/devkitpro/meson-cross.sh, which this image already has.
FROM docker.io/devkitpro/devkita64@sha256:1fc388c3a0d34bd2045a6dadcb1020e069d5f876a187fd705de14b4440c00282

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        meson=1.0.1-5 \
        ninja-build=1.11.1-2~deb12u1 \
        pkg-config=1.8.1-1 \
        flex=2.6.4-8.2 \
        bison=2:3.8.2+dfsg-1+b1 \
        python3-mako=1.2.4+ds-1 \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*
