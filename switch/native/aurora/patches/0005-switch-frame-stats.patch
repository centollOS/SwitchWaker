+namespace aurora::switch_stats {
+Counters& counters() noexcept {
+  static Counters s_counters;
+  return s_counters;
+}
+} // namespace aurora::switch_stats
+
+void aurora_switch_get_stats(AuroraSwitchStats* out) {
+  const auto& c = aurora::switch_stats::counters();
+  const auto load = [](const std::atomic<uint64_t>& v) { return v.load(std::memory_order_relaxed); };
+  *out = AuroraSwitchStats{
+      .frameSlotWaitNs = load(c.frameSlotWaitNs),
+      .stagingWaitNs = load(c.stagingWaitNs),
+      .queueFullWaitNs = load(c.queueFullWaitNs),
+      .workerBusyNs = load(c.workerBusyNs),
+      .workerEncodeNs = load(c.workerEncodeNs),
+      .workerEndFrameNs = load(c.workerEndFrameNs),
+      .workerUnmapNs = load(c.workerUnmapNs),
+      .workerAcquireNs = load(c.workerAcquireNs),
+      .workerSubmitNs = load(c.workerSubmitNs),
+      .workerPresentNs = load(c.workerPresentNs),
+      .workerEventsNs = load(c.workerEventsNs),
+      .workerFrames = load(c.workerFrames),
+      .pipelineCompiles = load(c.pipelineCompiles),
+      .pipelineCompileNs = load(c.pipelineCompileNs),
+      .pipelineCompileMaxNs = load(c.pipelineCompileMaxNs),
+  };
+}
+
 const AuroraStats* aurora_get_stats() { return &aurora::gfx::detail::resources().stats; }
 float aurora_get_fps() { return aurora::gfx::calculate_fps(); }
