index 9370469..145803c 100644
--- a/lib/sqlite_utils.hpp
+++ b/lib/sqlite_utils.hpp
@@ -7,15 +7,67 @@
 #include <filesystem>
 #include <string>
 #include <system_error>
+#if defined(__SWITCH__)
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <string_view>
+#include <unistd.h>
