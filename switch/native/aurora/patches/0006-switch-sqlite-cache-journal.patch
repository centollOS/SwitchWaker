diff --git a/lib/sqlite_utils.hpp b/lib/sqlite_utils.hpp
index 38db46b..8ddaa0b 100644
--- a/lib/sqlite_utils.hpp
+++ b/lib/sqlite_utils.hpp
@@ -4,8 +4,32 @@
 
 #include <sqlite3.h>
 
+#include <filesystem>
+#include <string>
+#include <system_error>
+
 namespace aurora::sqlite {
 
+#if defined(__SWITCH__)
+// Horizon (the Switch's SD card through newlib): no rollback journal file next to the database
+// (the cache tolerates losing its last transaction; a damaged file is removed and rebuilt, see
+// reset_cache_file) and no syncs.
+inline constexpr const char* CachePragmas = "PRAGMA journal_mode=MEMORY; PRAGMA synchronous=OFF;";
+
+// Removes a cache database (and a journal left next to it) that could not be opened, so the
+// caller can start it again from an empty file. Returns the size the file had, or -1.
+inline long long reset_cache_file(const std::string& path) {
+  std::error_code ec;
+  const auto size = std::filesystem::file_size(path, ec);
+  const long long result = ec ? -1 : static_cast<long long>(size);
+  std::filesystem::remove(path, ec);
+  std::filesystem::remove(path + "-journal", ec);
+  return result;
+}
+#else
+inline constexpr const char* CachePragmas = "PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL;";
+#endif
+
 inline int exec(sqlite3* db, const char* sql) { return sqlite3_exec(db, sql, nullptr, nullptr, nullptr); }
 
 template <typename T>
