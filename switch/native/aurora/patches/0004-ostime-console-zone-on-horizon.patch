+#if defined(__SWITCH__)
+// Horizon: libstdc++'s time zone database has no tzdata to read there (current_zone() faults in
+// reload_tzdb), and newlib's localtime knows only TZ. The console's own rule (libnx's time
+// service, opened by libnx at start) gives the local offset; without it, UTC.
+struct HorizonCalendarTime {
+  uint16_t year;
+  uint8_t month, day, hour, minute, second, pad;
+};
+struct HorizonCalendarAdditionalInfo {
+  uint32_t wday, yday;
+  char timezoneName[8];
+  uint32_t dst;
+  int32_t offset; // seconds east of UTC
+};
+extern "C" uint32_t timeToCalendarTimeWithMyRule(uint64_t timestamp, HorizonCalendarTime* caltime,
+                                                 HorizonCalendarAdditionalInfo* info);
+
+SystemDuration horizon_local_offset(SystemTime time) {
+  const std::time_t wallClock = chrono::system_clock::to_time_t(time);
+  HorizonCalendarTime cal{};
+  HorizonCalendarAdditionalInfo info{};
+  if (wallClock < 0 || timeToCalendarTimeWithMyRule(static_cast<uint64_t>(wallClock), &cal, &info) != 0) {
+    return SystemDuration::zero();
+  }
+  return chrono::duration_cast<SystemDuration>(chrono::seconds{info.offset});
+}
+#endif
+
