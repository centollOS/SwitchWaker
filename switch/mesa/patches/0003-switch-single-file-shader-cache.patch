+/*
+ * The disk shader cache on Horizon (Switch homebrew).
+ *
+ * disk_cache.c keeps one file per entry under a directory tree, an mmap'ed
+ * index file, flock'ed temporary files and zlib-compressed payloads; Horizon's
+ * newlib has no mmap, flock or getpwuid, and many small files are slow to open
+ * on the console's SD card (FAT32/exFAT). This backend keeps the same API in a
+ * single append-only file:
+ *
+ *    $MESA_SHADER_CACHE_DIR/mesa_shader_cache.bin   (or $MESA_GLSL_CACHE_DIR)
+ *
+ *    header:  "MESA-NX-SHADERS" NUL, u32 version, u32 header size,
+ *             sha1 of the driver keys (cache version, driver id, GPU name,
+ *             pointer size, driver flags), u32 reserved             48 bytes
+ *    records: u32 magic, key[20], u32 size, u32 crc32 of the payload,
+ *             payload                                                32 + size
+ *
+ * A size of 0xffffffff is a tombstone (disk_cache_remove). At creation the
+ * records' headers are read into an in-memory index (key -> offset, size);
+ * payloads are read and their CRC checked on disk_cache_get, so a damaged
+ * entry is a miss (and is forgotten), never bad data. A file written by
+ * another driver build (different keys sha1), with a bad header, or of an
+ * unknown version is emptied; a torn last record (the application stopped
+ * mid-write) is cut off. I/O goes straight to the file descriptor (stdio's
+ * buffer would read 64 KiB around every seek on the SD card): a record is
+ * written with one write() on the calling thread, an entry read with one
+ * read(); nothing is evicted: once the file reaches the
+ * maximum size (MESA_GLSL_CACHE_MAX_SIZE, default 256M) new entries are
+ * dropped.
+ *
+ * The cache is off unless MESA_SHADER_CACHE_DIR or MESA_GLSL_CACHE_DIR names a
+ * directory (the application sets it before eglInitialize), or when
+ * MESA_GLSL_CACHE_DISABLE / MESA_SHADER_CACHE_DISABLE is true.
+ * mesa_switch_shader_cache_status() describes what happened, for the log.
+ */
+
+#if defined(ENABLE_SHADER_CACHE) && \
+    (defined(__SWITCH__) || defined(MESA_DISK_CACHE_SINGLE_FILE))
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdarg.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include "c11/threads.h"
+#include "util/crc32.h"
+#include "util/debug.h"
+#include "util/disk_cache.h"
+#include "util/hash_table.h"
+#include "util/mesa-sha1.h"
+#include "util/os_time.h"
+#include "util/ralloc.h"
+#include "util/u_switch_stats.h"
+
+#define CACHE_VERSION 1
+
+#define PACK_FILE_NAME "mesa_shader_cache.bin"
+#define PACK_MAGIC "MESA-NX-SHADERS"   /* 15 characters and the NUL: 16 bytes */
+#define PACK_VERSION 1
+#define PACK_HEADER_SIZE 48
+#define RECORD_MAGIC 0x31435352u        /* "RSC1" */
+#define RECORD_HEADER_SIZE 32
+#define RECORD_TOMBSTONE 0xffffffffu
+#define DEFAULT_MAX_SIZE (256ull * 1024 * 1024)
+
+struct pack_entry {
+   uint64_t offset;   /* of the payload */
+   uint32_t size;
+};
+
+struct disk_cache {
+   mtx_t mutex;
+   int fd;
+   char *path;
+   uint64_t file_size;
+   uint64_t max_size;
+   bool write_failed;
+   struct hash_table *index;
+
+   /* Driver-specific cache keys. */
+   uint8_t *driver_keys_blob;
+   size_t driver_keys_blob_size;
+
+   disk_cache_put_cb blob_put_cb;
+   disk_cache_get_cb blob_get_cb;
+};
+
+static uint32_t
+key_hash(const void *key)
+{
+   uint32_t h;
+   memcpy(&h, key, sizeof(h));
+   return h;
+}
+
+static bool
+key_equals(const void *a, const void *b)
+{
+   return memcmp(a, b, CACHE_KEY_SIZE) == 0;
+}
+
+static void
+put_u32(uint8_t *p, uint32_t v)
+{
+   p[0] = v; p[1] = v >> 8; p[2] = v >> 16; p[3] = v >> 24;
+}
+
+static uint32_t
+get_u32(const uint8_t *p)
+{
+   return p[0] | (p[1] << 8) | (p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static bool
+read_at(int fd, uint64_t offset, void *buf, size_t size)
+{
+   if (lseek(fd, (off_t)offset, SEEK_SET) != (off_t)offset)
+      return false;
+   uint8_t *p = buf;
+   while (size) {
+      ssize_t n = read(fd, p, size);
+      if (n <= 0)
+         return false;
+      p += n;
+      size -= n;
+   }
+   return true;
+}
+
+static bool
+write_at(int fd, uint64_t offset, const void *buf, size_t size)
+{
+   if (lseek(fd, (off_t)offset, SEEK_SET) != (off_t)offset)
+      return false;
+   const uint8_t *p = buf;
+   while (size) {
+      ssize_t n = write(fd, p, size);
+      if (n <= 0)
+         return false;
+      p += n;
+      size -= n;
+   }
+   return true;
+}
+
+static void
+set_status(const char *fmt, ...)
+{
+   va_list args;
+   va_start(args, fmt);
+   vsnprintf(mesa_switch_shader_cache_status_line,
+             sizeof(mesa_switch_shader_cache_status_line), fmt, args);
+   va_end(args);
+}
+
+/* mkdir -p */
+static bool
+make_dirs(const char *dir)
+{
+   char *path = strdup(dir);
+   if (!path)
+      return false;
+   size_t len = strlen(path);
+   while (len > 1 && path[len - 1] == '/')
+      path[--len] = '\0';
+   for (char *p = path + 1; *p; p++) {
+      if (*p != '/')
+         continue;
+      *p = '\0';
+      if (p[-1] != ':')   /* "sdmc:" is the device, not a directory */
+         mkdir(path, 0755);
+      *p = '/';
+   }
+   struct stat st;
+   bool ok = mkdir(path, 0755) == 0 ||
+             (stat(path, &st) == 0 && S_ISDIR(st.st_mode));
+   free(path);
+   return ok;
+}
+
+static bool
+write_header(struct disk_cache *cache, const uint8_t keys_sha1[20])
+{
+   uint8_t header[PACK_HEADER_SIZE] = {0};
+   memcpy(header, PACK_MAGIC, 16);
+   put_u32(header + 16, PACK_VERSION);
+   put_u32(header + 20, PACK_HEADER_SIZE);
+   memcpy(header + 24, keys_sha1, 20);
+   if (!write_at(cache->fd, 0, header, sizeof(header)))
+      return false;
+   cache->file_size = PACK_HEADER_SIZE;
+   return true;
+}
+
+/* Empties the file and writes a new header. */
+static bool
+reset_file(struct disk_cache *cache, const uint8_t keys_sha1[20])
+{
+   if (cache->fd >= 0)
+      close(cache->fd);
+   cache->fd = open(cache->path, O_RDWR | O_CREAT | O_TRUNC, 0644);
+   if (cache->fd < 0)
+      return false;
+   _mesa_hash_table_clear(cache->index, NULL);
+   return write_header(cache, keys_sha1);
+}
+
+static void
+index_set(struct disk_cache *cache, const uint8_t *key, uint64_t offset,
+          uint32_t size)
+{
+   struct hash_entry *he = _mesa_hash_table_search(cache->index, key);
+   struct pack_entry *entry;
+   if (he) {
+      entry = he->data;
+   } else {
+      uint8_t *key_copy = ralloc_size(cache, CACHE_KEY_SIZE);
+      entry = ralloc(cache, struct pack_entry);
+      if (!key_copy || !entry)
+         return;
+      memcpy(key_copy, key, CACHE_KEY_SIZE);
+      _mesa_hash_table_insert(cache->index, key_copy, entry);
+   }
+   entry->offset = offset;
+   entry->size = size;
+}
+
+static void
+index_remove(struct disk_cache *cache, const uint8_t *key)
+{
+   struct hash_entry *he = _mesa_hash_table_search(cache->index, key);
+   if (he)
+      _mesa_hash_table_remove(cache->index, he);
+}
+
+/* Reads the records' headers into the index; returns the end of the last
+ * whole record. */
+static uint64_t
+scan_records(struct disk_cache *cache, uint64_t file_size, unsigned *records)
+{
+   uint64_t pos = PACK_HEADER_SIZE;
+   *records = 0;
+   while (pos + RECORD_HEADER_SIZE <= file_size) {
+      uint8_t rec[RECORD_HEADER_SIZE];
+      if (!read_at(cache->fd, pos, rec, sizeof(rec)))
+         break;
+      if (get_u32(rec) != RECORD_MAGIC)
+         break;
+      const uint32_t size = get_u32(rec + 24);
+      if (size == RECORD_TOMBSTONE) {
+         index_remove(cache, rec + 4);
+         pos += RECORD_HEADER_SIZE;
+         continue;
+      }
+      if (pos + RECORD_HEADER_SIZE + size > file_size)
+         break;
+      index_set(cache, rec + 4, pos + RECORD_HEADER_SIZE, size);
+      (*records)++;
+      pos += RECORD_HEADER_SIZE + size;
+   }
+   return pos;
+}
+
+static uint64_t
+read_max_size(void)
+{
+   const char *str = getenv("MESA_GLSL_CACHE_MAX_SIZE");
+   if (!str)
+      return DEFAULT_MAX_SIZE;
+   char *end;
+   uint64_t size = strtoull(str, &end, 10);
+   if (end == str || size == 0)
+      return DEFAULT_MAX_SIZE;
+   switch (*end) {
+   case 'K': case 'k': return size * 1024;
+   case 'M': case 'm': return size * 1024 * 1024;
+   default: return size * 1024 * 1024 * 1024;
+   }
+}
+
+static bool
+open_pack(struct disk_cache *cache, const char *dir)
+{
+   uint8_t keys_sha1[20];
+   _mesa_sha1_compute(cache->driver_keys_blob, cache->driver_keys_blob_size,
+                      keys_sha1);
+   const int64_t start = os_time_get_nano();
+
+   if (!make_dirs(dir)) {
+      set_status("off (cannot create %s: %s)", dir, strerror(errno));
+      return false;
+   }
+   cache->path = ralloc_asprintf(cache, "%s/%s", dir, PACK_FILE_NAME);
+   cache->fd = open(cache->path, O_RDWR);
+   const char *discarded = NULL;
+   uint64_t cut = 0;
+   unsigned records = 0;
+   if (cache->fd < 0) {
+      if (!reset_file(cache, keys_sha1)) {
+         set_status("off (cannot create %s: %s)", cache->path, strerror(errno));
+         return false;
+      }
+      discarded = "new file";
+   } else {
+      struct stat st;
+      uint64_t file_size = fstat(cache->fd, &st) == 0 ? st.st_size : 0;
+      uint8_t header[PACK_HEADER_SIZE];
+      if (file_size < PACK_HEADER_SIZE ||
+          !read_at(cache->fd, 0, header, sizeof(header)) ||
+          memcmp(header, PACK_MAGIC, 16) != 0 ||
+          get_u32(header + 16) != PACK_VERSION ||
+          get_u32(header + 20) != PACK_HEADER_SIZE) {
+         discarded = "discarded: not a cache file of this version";
+      } else if (memcmp(header + 24, keys_sha1, 20) != 0) {
+         discarded = "discarded: written by another driver build";
+      }
+      if (discarded) {
+         if (!reset_file(cache, keys_sha1)) {
+            set_status("off (cannot rewrite %s: %s)", cache->path,
+                       strerror(errno));
+            return false;
+         }
+      } else {
+         const uint64_t end = scan_records(cache, file_size, &records);
+         records = cache->index->entries; /* without replaced or removed ones */
+         cache->file_size = end;
+         if (end < file_size) {
+            cut = file_size - end;
+            if (ftruncate(cache->fd, (off_t)end) != 0) {
+               discarded = "discarded: cannot cut a damaged tail";
+               records = 0;
+               if (!reset_file(cache, keys_sha1)) {
+                  set_status("off (cannot rewrite %s: %s)", cache->path,
+                             strerror(errno));
+                  return false;
+               }
+            }
+         }
+      }
+   }
+
+   const double ms = (os_time_get_nano() - start) / 1e6;
+   char cut_note[64] = "";
+   if (cut)
+      snprintf(cut_note, sizeof(cut_note), "; cut %" PRIu64 " bytes of a damaged tail",
+               cut);
+   set_status("%s: %u entries, %.1f MiB, opened in %.0f ms%s%s%s (max %" PRIu64
+              " MiB)", cache->path, records, cache->file_size / (1024.0 * 1024.0),
+              ms, discarded ? "; " : "", discarded ? discarded : "", cut_note,
+              cache->max_size >> 20);
+   return true;
+}
+
+struct disk_cache *
+disk_cache_create(const char *gpu_name, const char *driver_id,
+                  uint64_t driver_flags)
+{
+   if (env_var_as_boolean("MESA_GLSL_CACHE_DISABLE", false) ||
+       env_var_as_boolean("MESA_SHADER_CACHE_DISABLE", false)) {
+      set_status("off (MESA_SHADER_CACHE_DISABLE)");
+      return NULL;
+   }
+   const char *dir = getenv("MESA_SHADER_CACHE_DIR");
+   if (!dir || !*dir)
+      dir = getenv("MESA_GLSL_CACHE_DIR");
+   if (!dir || !*dir) {
+      set_status("off (MESA_SHADER_CACHE_DIR not set)");
+      return NULL;
+   }
+
+   struct disk_cache *cache = rzalloc(NULL, struct disk_cache);
+   if (!cache)
+      return NULL;
+   if (mtx_init(&cache->mutex, mtx_plain) != thrd_success) {
+      ralloc_free(cache);
+      return NULL;
+   }
+   cache->fd = -1;
+   cache->index = _mesa_hash_table_create(cache, key_hash, key_equals);
+   cache->max_size = read_max_size();
+
+   /* The driver keys, as disk_cache.c builds them. */
+   uint8_t cache_version = CACHE_VERSION;
+   uint8_t ptr_size = sizeof(void *);
+   size_t id_size = strlen(driver_id) + 1;
+   size_t gpu_name_size = strlen(gpu_name) + 1;
+   cache->driver_keys_blob_size = sizeof(cache_version) + id_size +
+                                  gpu_name_size + sizeof(ptr_size) +
+                                  sizeof(driver_flags);
+   cache->driver_keys_blob = ralloc_size(cache, cache->driver_keys_blob_size);
+   if (!cache->index || !cache->driver_keys_blob)
+      goto fail;
+   uint8_t *p = cache->driver_keys_blob;
+   memcpy(p, &cache_version, sizeof(cache_version)); p += sizeof(cache_version);
+   memcpy(p, driver_id, id_size); p += id_size;
+   memcpy(p, gpu_name, gpu_name_size); p += gpu_name_size;
+   memcpy(p, &ptr_size, sizeof(ptr_size)); p += sizeof(ptr_size);
+   memcpy(p, &driver_flags, sizeof(driver_flags));
+
+   if (!open_pack(cache, dir))
+      goto fail;
+   return cache;
+
+fail:
+   if (cache->fd >= 0)
+      close(cache->fd);
+   mtx_destroy(&cache->mutex);
+   ralloc_free(cache);
+   return NULL;
+}
+
+void
+disk_cache_destroy(struct disk_cache *cache)
+{
+   if (!cache)
+      return;
+   if (cache->fd >= 0)
+      close(cache->fd);
+   mtx_destroy(&cache->mutex);
+   ralloc_free(cache);
+}
+
+void
+disk_cache_wait_for_idle(struct disk_cache *cache)
+{
+   (void)cache; /* writes are synchronous */
+}
+
+/* Appends a record (size RECORD_TOMBSTONE: a tombstone, no payload). Called
+ * with the mutex held. */
+static bool
+append_record(struct disk_cache *cache, const cache_key key, const void *data,
+              uint32_t size)
+{
+   const uint32_t payload = size == RECORD_TOMBSTONE ? 0 : size;
+   if (cache->write_failed)
+      return false;
+   if (cache->file_size + RECORD_HEADER_SIZE + payload > cache->max_size) {
+      mesa_switch_stat_add(MESA_SWITCH_CACHE_PUTS_DROPPED, 1);
+      return false;
+   }
+   uint8_t *rec = malloc(RECORD_HEADER_SIZE + payload);
+   if (!rec)
+      return false;
+   put_u32(rec, RECORD_MAGIC);
+   memcpy(rec + 4, key, CACHE_KEY_SIZE);
+   put_u32(rec + 24, size);
+   put_u32(rec + 28, payload ? util_hash_crc32(data, payload) : 0);
+   if (payload)
+      memcpy(rec + RECORD_HEADER_SIZE, data, payload);
+
+   const uint64_t start = cache->file_size;
+   const bool ok = write_at(cache->fd, start, rec, RECORD_HEADER_SIZE + payload);
+   free(rec);
+   if (!ok) {
+      /* Leave a whole file behind (a torn record would be cut at the next
+       * start anyway) and stop writing for this run. */
+      cache->write_failed = true;
+      if (ftruncate(cache->fd, (off_t)start) != 0) {
+         /* The next start cuts the torn record. */
+      }
+      mesa_switch_stat_add(MESA_SWITCH_CACHE_PUTS_DROPPED, 1);
+      return false;
+   }
+   cache->file_size = start + RECORD_HEADER_SIZE + payload;
+   return true;
+}
+
+static void
+pack_put(struct disk_cache *cache, const cache_key key, const void *data,
+         size_t size)
+{
+   if (size >= RECORD_TOMBSTONE)
+      return;
+   const int64_t start = os_time_get_nano();
+   mtx_lock(&cache->mutex);
+   if (!_mesa_hash_table_search(cache->index, key) &&
+       append_record(cache, key, data, (uint32_t)size)) {
+      index_set(cache, key, cache->file_size - size, (uint32_t)size);
+      mesa_switch_stat_add(MESA_SWITCH_CACHE_PUTS, 1);
+      mesa_switch_stat_add(MESA_SWITCH_CACHE_PUT_BYTES, RECORD_HEADER_SIZE + size);
+   }
+   mtx_unlock(&cache->mutex);
+   mesa_switch_stat_add(MESA_SWITCH_CACHE_PUT_NS, os_time_get_nano() - start);
+}
+
+void
+disk_cache_remove(struct disk_cache *cache, const cache_key key)
+{
+   mtx_lock(&cache->mutex);
+   if (_mesa_hash_table_search(cache->index, key)) {
+      index_remove(cache, key);
+      append_record(cache, key, NULL, RECORD_TOMBSTONE);
+   }
+   mtx_unlock(&cache->mutex);
+}
+
+void
+disk_cache_put(struct disk_cache *cache, const cache_key key,
+               const void *data, size_t size,
+               struct cache_item_metadata *cache_item_metadata)
+{
+   (void)cache_item_metadata;
+   if (cache->blob_put_cb) {
+      cache->blob_put_cb(key, CACHE_KEY_SIZE, data, size);
+      return;
+   }
+   pack_put(cache, key, data, size);
+}
+
+void *
+disk_cache_get(struct disk_cache *cache, const cache_key key, size_t *size)
+{
+   if (size)
+      *size = 0;
+
+   if (cache->blob_get_cb) {
+      signed long max_blob_size = 64 * 1024;
+      void *blob = malloc(max_blob_size);
+      if (!blob)
+         return NULL;
+      signed long bytes =
+         cache->blob_get_cb(key, CACHE_KEY_SIZE, blob, max_blob_size);
+      if (bytes > max_blob_size) {
+         /* EGL_ANDROID_blob_cache: the size of a value too large to copy. */
+         void *larger = realloc(blob, bytes);
+         if (!larger) {
+            free(blob);
+            return NULL;
+         }
+         blob = larger;
+         max_blob_size = bytes;
+         bytes = cache->blob_get_cb(key, CACHE_KEY_SIZE, blob, max_blob_size);
+      }
+      if (bytes <= 0 || bytes > max_blob_size) {
+         free(blob);
+         return NULL;
+      }
+      if (size)
+         *size = bytes;
+      return blob;
+   }
+
+   const int64_t start = os_time_get_nano();
+   void *data = NULL;
+   mesa_switch_stat_add(MESA_SWITCH_CACHE_GETS, 1);
+   mtx_lock(&cache->mutex);
+   struct hash_entry *he = _mesa_hash_table_search(cache->index, key);
+   if (he) {
+      const struct pack_entry *entry = he->data;
+      /* The record's header and payload in one read; the payload is moved
+       * to the front of the buffer the caller frees. */
+      uint8_t *rec = malloc(RECORD_HEADER_SIZE + entry->size);
+      bool ok = rec &&
+                read_at(cache->fd, entry->offset - RECORD_HEADER_SIZE, rec,
+                        RECORD_HEADER_SIZE + entry->size) &&
+                get_u32(rec) == RECORD_MAGIC &&
+                memcmp(rec + 4, key, CACHE_KEY_SIZE) == 0 &&
+                get_u32(rec + 24) == entry->size &&
+                get_u32(rec + 28) ==
+                   (entry->size ? util_hash_crc32(rec + RECORD_HEADER_SIZE,
+                                                  entry->size) : 0);
+      if (ok) {
+         memmove(rec, rec + RECORD_HEADER_SIZE, entry->size);
+         data = rec;
+      } else {
+         free(rec);
+      }
+      if (ok) {
+         if (size)
+            *size = entry->size;
+         mesa_switch_stat_add(MESA_SWITCH_CACHE_GET_HITS, 1);
+      } else {
+         /* A damaged entry is a miss, and is forgotten for this run (its
+          * replacement is appended after it, which a later scan prefers). */
+         data = NULL;
+         index_remove(cache, key);
+         mesa_switch_stat_add(MESA_SWITCH_CACHE_CORRUPT, 1);
+      }
+   }
+   mtx_unlock(&cache->mutex);
+   mesa_switch_stat_add(MESA_SWITCH_CACHE_GET_NS, os_time_get_nano() - start);
+   return data;
+}
+
+void
+disk_cache_put_key(struct disk_cache *cache, const cache_key key)
+{
+   if (cache->blob_put_cb) {
+      const uint32_t *key_chunk = (const uint32_t *) key;
+      cache->blob_put_cb(key, CACHE_KEY_SIZE, key_chunk, sizeof(uint32_t));
+      return;
+   }
+   pack_put(cache, key, NULL, 0);
+}
+
+bool
+disk_cache_has_key(struct disk_cache *cache, const cache_key key)
+{
+   if (cache->blob_get_cb) {
+      uint32_t blob;
+      return cache->blob_get_cb(key, CACHE_KEY_SIZE, &blob, sizeof(uint32_t));
+   }
+   mtx_lock(&cache->mutex);
+   const bool found = _mesa_hash_table_search(cache->index, key) != NULL;
+   mtx_unlock(&cache->mutex);
+   mesa_switch_stat_add(found ? MESA_SWITCH_CACHE_HAS_KEY_HITS
+                              : MESA_SWITCH_CACHE_HAS_KEY_MISSES, 1);
+   return found;
+}
+
+void
+disk_cache_compute_key(struct disk_cache *cache, const void *data, size_t size,
+                       cache_key key)
+{
+   struct mesa_sha1 ctx;
+
+   _mesa_sha1_init(&ctx);
+   _mesa_sha1_update(&ctx, cache->driver_keys_blob,
+                     cache->driver_keys_blob_size);
+   _mesa_sha1_update(&ctx, data, size);
+   _mesa_sha1_final(&ctx, key);
+}
+
+void
+disk_cache_set_callbacks(struct disk_cache *cache, disk_cache_put_cb put,
+                         disk_cache_get_cb get)
+{
+   cache->blob_put_cb = put;
+   cache->blob_get_cb = get;
+}
+
+#endif /* ENABLE_SHADER_CACHE && (__SWITCH__ || MESA_DISK_CACHE_SINGLE_FILE) */
