+/*
+ * The disk shader cache on Horizon (Switch homebrew).
+ *
+ * disk_cache.c keeps one file per entry under a directory tree, an mmap'ed
+ * index file, flock'ed temporary files and zlib-compressed payloads; Horizon's
+ * newlib has no mmap, flock or getpwuid, and many small files are slow to open
+ * on the console's SD card (FAT32/exFAT). This backend keeps the same API in a
+ * single append-only file:
+ *
+ *    $MESA_SHADER_CACHE_DIR/mesa_shader_cache.bin   (or $MESA_GLSL_CACHE_DIR)
+ *
+ *    header:  "MESA-NX-SHADERS" NUL, u32 version, u32 header size,
+ *             sha1 of the driver keys (cache version, driver id, GPU name,
+ *             pointer size, driver flags), u32 generation (0 in a file
+ *             written before the index file existed)                48 bytes
+ *    records: u32 magic, key[20], u32 size, u32 crc32 of the payload,
+ *             payload                                                32 + size
+ *
+ * and beside it an index of the records, so that opening the cache costs one
+ * read instead of one per record (32-byte reads at ~0.3 ms each on the SD
+ * card: 2747 records took 860 ms):
+ *
+ *    $MESA_SHADER_CACHE_DIR/mesa_shader_cache.idx
+ *
+ *    header:  "MESA-NX-SHIDX" NUL NUL NUL, u32 version, u32 header size,
+ *             u32 generation of the .bin it describes, u32 crc32 of the
+ *             first 28 bytes                                         32 bytes
+ *    entries: u32 magic, key[20], u32 size (or tombstone), u64 offset of
+ *             the record in the .bin, u32 crc32 of the first 36 bytes 40 bytes
+ *
+ * A record is written to the .bin first, then its entry to the .idx (one
+ * write() each). At creation the .idx is read in one read(); its entries are
+ * taken while they are whole (CRC), contiguous (each record starts where the
+ * previous one ended) and inside the .bin, and the last one's record header
+ * is read back from the .bin to check that the two files belong together
+ * (with the generation, a random number written to both whenever the .bin is
+ * created). Records the .idx does not cover (the application stopped between
+ * the two writes, or a failed .idx write) are then read one header at a time
+ * and added to it; a missing, foreign or damaged .idx is rebuilt that way from
+ * the whole .bin, once. The .bin's format is unchanged (version 1): an older
+ * build ignores the .idx and the generation.
+ *
+ * Stale entries are pruned. A shader change (a new NRO) leaves the old
+ * programs' entries in the file forever otherwise: 2747 entries became 5135
+ * (26 MiB) after one, and every one of them costs at open. A third file
+ * remembers when each entry was last used:
+ *
+ *    $MESA_SHADER_CACHE_DIR/mesa_shader_cache.use
+ *
+ *    header:  "MESA-NX-SHUSE" NUL NUL NUL, u32 version, u32 boot (the number
+ *             of the run that wrote it), u32 entry count, u32 crc32 of the
+ *             entries                                                32 bytes
+ *    entries: key[20], u32 boot it was last used in (put, get or has_key
+ *             hit)                                                   24 bytes
+ *
+ * read with one read() at creation (each run is the previous one's boot + 1;
+ * an entry it does not list, or a missing or damaged file, counts as used in
+ * this run, so nothing is pruned on a guess). A maintenance thread writes it
+ * (one write) every MAINT_PERIOD_S seconds while uses changed and at
+ * disk_cache_destroy, and once per run, MESA_SHADER_CACHE_PRUNE_DELAY seconds
+ * after creation (default 60: past the application's start-up), compacts the
+ * cache if the entries unused for MESA_SHADER_CACHE_PRUNE_BOOTS runs (default
+ * 5; 0: never) plus the dead records (replaced, removed, damaged) make up a
+ * quarter of the file and at least 1 MiB, or any when the file is over three
+ * quarters of the maximum size. Compaction never blocks a caller for the
+ * copy: the kept records are copied (CRC checked, in file order, in small
+ * steps) through a descriptor of its own into .bin.tmp, with a fresh
+ * generation; then, under the cache's mutex, the records appended meanwhile
+ * are copied too, the new .idx is written, the old files are replaced
+ * (unlink, then rename: Horizon's rename does not replace) and the in-memory
+ * index is rebuilt. A start that finds a .bin.tmp but no .bin (stopped in
+ * between) takes the .tmp; leftover .tmp files are deleted.
+ * mesa_switch_shader_cache_maintenance() returns a line describing the last
+ * compaction, for the log.
+ *
+ * A size of 0xffffffff is a tombstone (disk_cache_remove). At creation the
+ * records' headers are read into an in-memory index (key -> offset, size);
+ * payloads are read and their CRC checked on disk_cache_get, so a damaged
+ * entry is a miss (and is forgotten), never bad data. A file written by
+ * another driver build (different keys sha1), with a bad header, or of an
+ * unknown version is emptied; a torn last record (the application stopped
+ * mid-write) is cut off. I/O goes straight to the file descriptor (stdio's
+ * buffer would read 64 KiB around every seek on the SD card): a record is
+ * written with one write() on the calling thread, an entry read with one
+ * read(); nothing is evicted: once the file reaches the
+ * maximum size (MESA_GLSL_CACHE_MAX_SIZE, default 256M) new entries are
+ * dropped.
+ *
+ * The cache is off unless MESA_SHADER_CACHE_DIR or MESA_GLSL_CACHE_DIR names a
+ * directory (the application sets it before eglInitialize), or when
+ * MESA_GLSL_CACHE_DISABLE / MESA_SHADER_CACHE_DISABLE is true.
+ * mesa_switch_shader_cache_status() describes what happened, for the log.
+ */
+
+#if defined(ENABLE_SHADER_CACHE) && \
+    (defined(__SWITCH__) || defined(MESA_DISK_CACHE_SINGLE_FILE))
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdarg.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include "c11/threads.h"
+#include "util/crc32.h"
+#include "util/debug.h"
+#include "util/disk_cache.h"
+#include "util/hash_table.h"
+#include "util/mesa-sha1.h"
+#include "util/os_time.h"
+#include "util/ralloc.h"
+#include "util/u_switch_stats.h"
+
+#define CACHE_VERSION 1
+
+#define PACK_FILE_NAME "mesa_shader_cache.bin"
+#define PACK_MAGIC "MESA-NX-SHADERS"   /* 15 characters and the NUL: 16 bytes */
+#define PACK_VERSION 1
+#define PACK_HEADER_SIZE 48
+#define RECORD_MAGIC 0x31435352u        /* "RSC1" */
+#define RECORD_HEADER_SIZE 32
+#define RECORD_TOMBSTONE 0xffffffffu
+#define DEFAULT_MAX_SIZE (256ull * 1024 * 1024)
+
+#define IDX_FILE_NAME "mesa_shader_cache.idx"
+#define IDX_MAGIC "MESA-NX-SHIDX"      /* 13 characters, padded with NULs to 16 */
+#define IDX_VERSION 1
+#define IDX_HEADER_SIZE 32
+#define IDX_ENTRY_MAGIC 0x31584449u     /* "IDX1" */
+#define IDX_ENTRY_SIZE 40
+
+#define USE_FILE_NAME "mesa_shader_cache.use"
+#define USE_MAGIC "MESA-NX-SHUSE"      /* 13 characters, padded with NULs to 16 */
+#define USE_VERSION 1
+#define USE_HEADER_SIZE 32
+#define USE_ENTRY_SIZE 24
+#define TMP_SUFFIX ".tmp"
+#define DEFAULT_PRUNE_BOOTS 5
+#define DEFAULT_PRUNE_DELAY_S 60
+#define MAINT_PERIOD_S 15
+#define PRUNE_MIN_BYTES (1024 * 1024)
+
+struct pack_entry {
+   uint64_t offset;   /* of the payload */
+   uint32_t size;
+   uint32_t last_use; /* the run (boot) it was last used in */
+};
+
+struct disk_cache {
+   mtx_t mutex;
+   int fd;
+   char *path;
+   uint64_t file_size;
+   uint64_t max_size;
+   bool write_failed;
+   struct hash_table *index;
+
+   /* The .idx beside the .bin: its descriptor, path and length, the .bin's
+    * generation, and whether a write to it failed (no more entries this run;
+    * the next start reads the records it misses from the .bin). */
+   int idx_fd;
+   char *idx_path;
+   uint64_t idx_size;
+   uint32_t generation;
+   bool idx_failed;
+
+   /* The .use file, this run's number and whether a use changed since it was
+    * last written; the pruning settings; the maintenance thread. */
+   uint8_t keys_sha1[20];
+   char *use_path;
+   int use_fd;
+   uint32_t boot;
+   bool use_dirty;
+   uint32_t prune_boots;
+   uint64_t prune_delay_ns;
+   int64_t created_ns;
+   bool maint_running;
+   bool maint_stop;
+   thrd_t maint_thread;
+   mtx_t maint_mutex;
+   cnd_t maint_cnd;
+
+   /* Driver-specific cache keys. */
+   uint8_t *driver_keys_blob;
+   size_t driver_keys_blob_size;
+
+   disk_cache_put_cb blob_put_cb;
+   disk_cache_get_cb blob_get_cb;
+};
+
+static uint32_t
+key_hash(const void *key)
+{
+   uint32_t h;
+   memcpy(&h, key, sizeof(h));
+   return h;
+}
+
+static bool
+key_equals(const void *a, const void *b)
+{
+   return memcmp(a, b, CACHE_KEY_SIZE) == 0;
+}
+
+static void
+put_u32(uint8_t *p, uint32_t v)
+{
+   p[0] = v; p[1] = v >> 8; p[2] = v >> 16; p[3] = v >> 24;
+}
+
+static uint32_t
+get_u32(const uint8_t *p)
+{
+   return p[0] | (p[1] << 8) | (p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static bool
+read_at(int fd, uint64_t offset, void *buf, size_t size)
+{
+   if (lseek(fd, (off_t)offset, SEEK_SET) != (off_t)offset)
+      return false;
+   uint8_t *p = buf;
+   while (size) {
+      ssize_t n = read(fd, p, size);
+      if (n <= 0)
+         return false;
+      p += n;
+      size -= n;
+   }
+   return true;
+}
+
+static bool
+write_at(int fd, uint64_t offset, const void *buf, size_t size)
+{
+   if (lseek(fd, (off_t)offset, SEEK_SET) != (off_t)offset)
+      return false;
+   const uint8_t *p = buf;
+   while (size) {
+      ssize_t n = write(fd, p, size);
+      if (n <= 0)
+         return false;
+      p += n;
+      size -= n;
+   }
+   return true;
+}
+
+static void
+set_status(const char *fmt, ...)
+{
+   va_list args;
+   va_start(args, fmt);
+   vsnprintf(mesa_switch_shader_cache_status_line,
+             sizeof(mesa_switch_shader_cache_status_line), fmt, args);
+   va_end(args);
+}
+
+/* mkdir -p */
+static bool
+make_dirs(const char *dir)
+{
+   char *path = strdup(dir);
+   if (!path)
+      return false;
+   size_t len = strlen(path);
+   while (len > 1 && path[len - 1] == '/')
+      path[--len] = '\0';
+   for (char *p = path + 1; *p; p++) {
+      if (*p != '/')
+         continue;
+      *p = '\0';
+      if (p[-1] != ':')   /* "sdmc:" is the device, not a directory */
+         mkdir(path, 0755);
+      *p = '/';
+   }
+   struct stat st;
+   bool ok = mkdir(path, 0755) == 0 ||
+             (stat(path, &st) == 0 && S_ISDIR(st.st_mode));
+   free(path);
+   return ok;
+}
+
+/* A random, nonzero generation for a new .bin, other than old. */
+static uint32_t
+new_generation(uint32_t old)
+{
+   const uint64_t t = (uint64_t)os_time_get_nano();
+   uint32_t g = (uint32_t)t ^ (uint32_t)(t >> 32) ^ ((uint32_t)getpid() << 16);
+   if (g == old)
+      g++;
+   return g ? g : 1;
+}
+
+static bool
+write_header(struct disk_cache *cache, const uint8_t keys_sha1[20])
+{
+   uint8_t header[PACK_HEADER_SIZE] = {0};
+   memcpy(header, PACK_MAGIC, 16);
+   put_u32(header + 16, PACK_VERSION);
+   put_u32(header + 20, PACK_HEADER_SIZE);
+   memcpy(header + 24, keys_sha1, 20);
+   put_u32(header + 44, cache->generation);
+   if (!write_at(cache->fd, 0, header, sizeof(header)))
+      return false;
+   cache->file_size = PACK_HEADER_SIZE;
+   return true;
+}
+
+/* Empties the .idx and writes its header for the .bin's generation. */
+static bool
+reset_idx(struct disk_cache *cache)
+{
+   if (cache->idx_fd >= 0)
+      close(cache->idx_fd);
+   cache->idx_size = 0;
+   cache->idx_failed = true;
+   cache->idx_fd = open(cache->idx_path, O_RDWR | O_CREAT | O_TRUNC, 0644);
+   if (cache->idx_fd < 0)
+      return false;
+   uint8_t header[IDX_HEADER_SIZE] = {0};
+   memcpy(header, IDX_MAGIC, sizeof(IDX_MAGIC));
+   put_u32(header + 16, IDX_VERSION);
+   put_u32(header + 20, IDX_HEADER_SIZE);
+   put_u32(header + 24, cache->generation);
+   put_u32(header + 28, util_hash_crc32(header, 28));
+   if (!write_at(cache->idx_fd, 0, header, sizeof(header)))
+      return false;
+   cache->idx_size = IDX_HEADER_SIZE;
+   cache->idx_failed = false;
+   return true;
+}
+
+static void
+fill_idx_entry(uint8_t *e, const uint8_t *key, uint32_t size, uint64_t offset)
+{
+   put_u32(e, IDX_ENTRY_MAGIC);
+   memcpy(e + 4, key, CACHE_KEY_SIZE);
+   put_u32(e + 24, size);
+   put_u32(e + 28, (uint32_t)offset);
+   put_u32(e + 32, (uint32_t)(offset >> 32));
+   put_u32(e + 36, util_hash_crc32(e, 36));
+}
+
+/* Appends whole entries to the .idx with one write. After a failed write no
+ * more are written this run (a torn entry fails its CRC at the next start,
+ * which then reads the records it misses from the .bin). */
+static void
+idx_append(struct disk_cache *cache, const uint8_t *entries, size_t bytes)
+{
+   if (cache->idx_failed || cache->idx_fd < 0 || bytes == 0)
+      return;
+   if (!write_at(cache->idx_fd, cache->idx_size, entries, bytes)) {
+      cache->idx_failed = true;
+      if (ftruncate(cache->idx_fd, (off_t)cache->idx_size) != 0) {
+         /* The next start cuts the torn entry. */
+      }
+      return;
+   }
+   cache->idx_size += bytes;
+}
+
+/* Empties the .bin and the .idx (a new generation) and writes their headers. */
+static bool
+reset_file(struct disk_cache *cache, const uint8_t keys_sha1[20])
+{
+   if (cache->fd >= 0)
+      close(cache->fd);
+   cache->fd = open(cache->path, O_RDWR | O_CREAT | O_TRUNC, 0644);
+   if (cache->fd < 0)
+      return false;
+   _mesa_hash_table_clear(cache->index, NULL);
+   cache->generation = new_generation(cache->generation);
+   if (!write_header(cache, keys_sha1))
+      return false;
+   reset_idx(cache); /* without it the cache works, and the next start rebuilds it */
+   return true;
+}
+
+static void
+index_set(struct disk_cache *cache, const uint8_t *key, uint64_t offset,
+          uint32_t size)
+{
+   struct hash_entry *he = _mesa_hash_table_search(cache->index, key);
+   struct pack_entry *entry;
+   if (he) {
+      entry = he->data;
+   } else {
+      uint8_t *key_copy = ralloc_size(cache, CACHE_KEY_SIZE);
+      entry = ralloc(cache, struct pack_entry);
+      if (!key_copy || !entry)
+         return;
+      memcpy(key_copy, key, CACHE_KEY_SIZE);
+      _mesa_hash_table_insert(cache->index, key_copy, entry);
+      entry->last_use = cache->boot;
+      cache->use_dirty = true;
+   }
+   entry->offset = offset;
+   entry->size = size;
+}
+
+/* An entry was used in this run. Called with the mutex held. */
+static void
+mark_used(struct disk_cache *cache, struct pack_entry *entry)
+{
+   if (entry->last_use != cache->boot) {
+      entry->last_use = cache->boot;
+      cache->use_dirty = true;
+   }
+}
+
+static void
+index_remove(struct disk_cache *cache, const uint8_t *key)
+{
+   struct hash_entry *he = _mesa_hash_table_search(cache->index, key);
+   if (he)
+      _mesa_hash_table_remove(cache->index, he);
+}
+
+/* Reads the .idx (one read) into the index. Returns the end, in the .bin, of
+ * the records it covers; PACK_HEADER_SIZE with *why set when it cannot be
+ * used (nothing is taken from it then). Entries past the first damaged, out
+ * of order or outside the .bin are cut from the file (*cut_entries). */
+static uint64_t
+load_idx(struct disk_cache *cache, uint64_t file_size, unsigned *entries,
+         unsigned *cut_entries, const char **why)
+{
+   *entries = 0;
+   *cut_entries = 0;
+   *why = NULL;
+   if (cache->generation == 0) {
+      *why = "the cache file predates the index";
+      return PACK_HEADER_SIZE;
+   }
+   cache->idx_fd = open(cache->idx_path, O_RDWR);
+   if (cache->idx_fd < 0) {
+      *why = "no index file";
+      return PACK_HEADER_SIZE;
+   }
+   struct stat st;
+   const uint64_t idx_file = fstat(cache->idx_fd, &st) == 0 ? st.st_size : 0;
+   uint8_t *buf = idx_file >= IDX_HEADER_SIZE ? malloc(idx_file) : NULL;
+   if (!buf || !read_at(cache->idx_fd, 0, buf, idx_file)) {
+      free(buf);
+      *why = "the index file cannot be read";
+      return PACK_HEADER_SIZE;
+   }
+   if (memcmp(buf, IDX_MAGIC, sizeof(IDX_MAGIC)) != 0 ||
+       get_u32(buf + 16) != IDX_VERSION ||
+       get_u32(buf + 20) != IDX_HEADER_SIZE ||
+       get_u32(buf + 28) != util_hash_crc32(buf, 28)) {
+      free(buf);
+      *why = "the index file is damaged or of another version";
+      return PACK_HEADER_SIZE;
+   }
+   if (get_u32(buf + 24) != cache->generation) {
+      free(buf);
+      *why = "the index file belongs to another cache file";
+      return PACK_HEADER_SIZE;
+   }
+
+   /* The whole, contiguous entries inside the .bin. */
+   uint64_t pos = PACK_HEADER_SIZE;
+   uint64_t used = IDX_HEADER_SIZE;
+   uint64_t last_offset = 0;
+   const uint8_t *last = NULL;
+   while (used + IDX_ENTRY_SIZE <= idx_file) {
+      const uint8_t *e = buf + used;
+      if (get_u32(e) != IDX_ENTRY_MAGIC ||
+          get_u32(e + 36) != util_hash_crc32(e, 36))
+         break;
+      const uint32_t size = get_u32(e + 24);
+      const uint64_t offset = get_u32(e + 28) | ((uint64_t)get_u32(e + 32) << 32);
+      const uint64_t length =
+         RECORD_HEADER_SIZE + (size == RECORD_TOMBSTONE ? 0 : (uint64_t)size);
+      if (offset != pos || pos + length > file_size)
+         break;
+      last = e;
+      last_offset = offset;
+      pos += length;
+      used += IDX_ENTRY_SIZE;
+   }
+
+   /* The last covered record must be the one the .idx names: the files
+    * belong together. */
+   if (last) {
+      uint8_t rec[RECORD_HEADER_SIZE];
+      if (!read_at(cache->fd, last_offset, rec, sizeof(rec)) ||
+          get_u32(rec) != RECORD_MAGIC ||
+          memcmp(rec + 4, last + 4, CACHE_KEY_SIZE) != 0 ||
+          get_u32(rec + 24) != get_u32(last + 24)) {
+         free(buf);
+         *why = "the index file does not match the cache file";
+         return PACK_HEADER_SIZE;
+      }
+   }
+
+   uint64_t offset = PACK_HEADER_SIZE;
+   for (uint64_t at = IDX_HEADER_SIZE; at < used; at += IDX_ENTRY_SIZE) {
+      const uint8_t *e = buf + at;
+      const uint32_t size = get_u32(e + 24);
+      if (size == RECORD_TOMBSTONE) {
+         index_remove(cache, e + 4);
+         offset += RECORD_HEADER_SIZE;
+      } else {
+         index_set(cache, e + 4, offset + RECORD_HEADER_SIZE, size);
+         offset += RECORD_HEADER_SIZE + (uint64_t)size;
+      }
+      (*entries)++;
+   }
+   free(buf);
+
+   cache->idx_size = used;
+   cache->idx_failed = false;
+   if (used < idx_file) {
+      *cut_entries = (unsigned)((idx_file - used + IDX_ENTRY_SIZE - 1) / IDX_ENTRY_SIZE);
+      if (ftruncate(cache->idx_fd, (off_t)used) != 0)
+         cache->idx_failed = true; /* not extended this run; read again next start */
+   }
+   return pos;
+}
+
+/* Reads the records' headers from pos on, one read each, into the index and
+ * appends their entries to the .idx; returns the end of the last whole
+ * record. */
+static uint64_t
+scan_records(struct disk_cache *cache, uint64_t pos, uint64_t file_size,
+             unsigned *records)
+{
+   *records = 0;
+   uint8_t *entries = NULL;
+   size_t entries_size = 0, entries_cap = 0;
+   while (pos + RECORD_HEADER_SIZE <= file_size) {
+      uint8_t rec[RECORD_HEADER_SIZE];
+      if (!read_at(cache->fd, pos, rec, sizeof(rec)))
+         break;
+      if (get_u32(rec) != RECORD_MAGIC)
+         break;
+      const uint32_t size = get_u32(rec + 24);
+      const uint64_t length =
+         RECORD_HEADER_SIZE + (size == RECORD_TOMBSTONE ? 0 : (uint64_t)size);
+      if (pos + length > file_size)
+         break;
+      if (size == RECORD_TOMBSTONE)
+         index_remove(cache, rec + 4);
+      else
+         index_set(cache, rec + 4, pos + RECORD_HEADER_SIZE, size);
+      if (entries_size + IDX_ENTRY_SIZE > entries_cap) {
+         const size_t cap = entries_cap ? entries_cap * 2 : 64 * IDX_ENTRY_SIZE;
+         uint8_t *grown = realloc(entries, cap);
+         if (grown) {
+            entries = grown;
+            entries_cap = cap;
+         }
+      }
+      if (entries_size + IDX_ENTRY_SIZE <= entries_cap) {
+         fill_idx_entry(entries + entries_size, rec + 4, size, pos);
+         entries_size += IDX_ENTRY_SIZE;
+      } else {
+         cache->idx_failed = true; /* out of memory: the next start reads them */
+      }
+      (*records)++;
+      pos += length;
+   }
+   idx_append(cache, entries, entries_size);
+   free(entries);
+   return pos;
+}
+
+static uint64_t
+read_max_size(void)
+{
+   const char *str = getenv("MESA_GLSL_CACHE_MAX_SIZE");
+   if (!str)
+      return DEFAULT_MAX_SIZE;
+   char *end;
+   uint64_t size = strtoull(str, &end, 10);
+   if (end == str || size == 0)
+      return DEFAULT_MAX_SIZE;
+   switch (*end) {
+   case 'K': case 'k': return size * 1024;
+   case 'M': case 'm': return size * 1024 * 1024;
+   default: return size * 1024 * 1024 * 1024;
+   }
+}
+
+
+static uint32_t
+read_env_u32(const char *name, uint32_t def)
+{
+   const char *str = getenv(name);
+   if (!str || !*str)
+      return def;
+   char *end;
+   unsigned long v = strtoul(str, &end, 10);
+   return end == str ? def : (uint32_t)v;
+}
+
+static char *
+tmp_path(void *ctx, const char *path)
+{
+   return ralloc_asprintf(ctx, "%s%s", path, TMP_SUFFIX);
+}
+
+/* A compaction stopped between removing the old files and renaming the new
+ * ones leaves a .bin.tmp and no .bin: take it (its .idx.tmp too). Any other
+ * .tmp is a compaction stopped before that point: deleted. Returns a note for
+ * the status line, or NULL. */
+static const char *
+recover_tmp_files(struct disk_cache *cache)
+{
+   char *bin_tmp = tmp_path(cache, cache->path);
+   char *idx_tmp = tmp_path(cache, cache->idx_path);
+   struct stat st;
+   const char *note = NULL;
+   if (stat(cache->path, &st) != 0 && stat(bin_tmp, &st) == 0) {
+      if (rename(bin_tmp, cache->path) == 0) {
+         note = "; took the file of an interrupted compaction";
+         unlink(cache->idx_path);
+         if (rename(idx_tmp, cache->idx_path) != 0) {
+            /* The index is rebuilt from the .bin. */
+         }
+      }
+   }
+   unlink(bin_tmp);
+   unlink(idx_tmp);
+   ralloc_free(bin_tmp);
+   ralloc_free(idx_tmp);
+   return note;
+}
+
+/* This run's number: the .use file's + 1 (1 without one). Opens it. */
+static void
+load_use_header(struct disk_cache *cache)
+{
+   cache->boot = 1;
+   cache->use_fd = open(cache->use_path, O_RDWR | O_CREAT, 0644);
+   uint8_t header[USE_HEADER_SIZE];
+   if (cache->use_fd >= 0 && read_at(cache->use_fd, 0, header, sizeof(header)) &&
+       memcmp(header, USE_MAGIC, sizeof(USE_MAGIC)) == 0 &&
+       get_u32(header + 16) == USE_VERSION && get_u32(header + 20) != 0)
+      cache->boot = get_u32(header + 20) + 1;
+   cache->use_dirty = true; /* the run count, at least */
+}
+
+/* Gives the index's entries the run they were last used in, from the .use
+ * file (one read); returns how many are older than the pruning limit. */
+static unsigned
+apply_use(struct disk_cache *cache)
+{
+   if (cache->use_fd < 0)
+      return 0;
+   struct stat st;
+   const uint64_t size = fstat(cache->use_fd, &st) == 0 ? st.st_size : 0;
+   uint8_t *buf = size >= USE_HEADER_SIZE ? malloc(size) : NULL;
+   if (!buf || !read_at(cache->use_fd, 0, buf, size)) {
+      free(buf);
+      return 0;
+   }
+   const uint32_t count = get_u32(buf + 24);
+   unsigned stale = 0;
+   if (memcmp(buf, USE_MAGIC, sizeof(USE_MAGIC)) == 0 &&
+       get_u32(buf + 16) == USE_VERSION &&
+       (uint64_t)USE_HEADER_SIZE + (uint64_t)count * USE_ENTRY_SIZE <= size &&
+       get_u32(buf + 28) == util_hash_crc32(buf + USE_HEADER_SIZE,
+                                            (size_t)count * USE_ENTRY_SIZE)) {
+      for (uint32_t i = 0; i < count; i++) {
+         const uint8_t *e = buf + USE_HEADER_SIZE + (size_t)i * USE_ENTRY_SIZE;
+         struct hash_entry *he = _mesa_hash_table_search(cache->index, e);
+         const uint32_t last = get_u32(e + 20);
+         if (!he || last >= cache->boot)
+            continue;
+         struct pack_entry *entry = he->data;
+         entry->last_use = last;
+         if (cache->prune_boots && cache->boot - last >= cache->prune_boots)
+            stale++;
+      }
+   }
+   free(buf);
+   return stale;
+}
+
+static bool
+open_pack(struct disk_cache *cache, const char *dir)
+{
+   uint8_t keys_sha1[20];
+   _mesa_sha1_compute(cache->driver_keys_blob, cache->driver_keys_blob_size,
+                      keys_sha1);
+   const int64_t start = os_time_get_nano();
+
+   if (!make_dirs(dir)) {
+      set_status("off (cannot create %s: %s)", dir, strerror(errno));
+      return false;
+   }
+   cache->path = ralloc_asprintf(cache, "%s/%s", dir, PACK_FILE_NAME);
+   cache->idx_path = ralloc_asprintf(cache, "%s/%s", dir, IDX_FILE_NAME);
+   cache->use_path = ralloc_asprintf(cache, "%s/%s", dir, USE_FILE_NAME);
+   memcpy(cache->keys_sha1, keys_sha1, sizeof(keys_sha1));
+   const char *recovered = recover_tmp_files(cache);
+   load_use_header(cache);
+   cache->fd = open(cache->path, O_RDWR);
+   const char *discarded = NULL;
+   uint64_t cut = 0;
+   unsigned records = 0;
+   char idx_note[160] = "";
+   if (cache->fd < 0) {
+      if (!reset_file(cache, keys_sha1)) {
+         set_status("off (cannot create %s: %s)", cache->path, strerror(errno));
+         return false;
+      }
+      discarded = "new file";
+   } else {
+      struct stat st;
+      uint64_t file_size = fstat(cache->fd, &st) == 0 ? st.st_size : 0;
+      uint8_t header[PACK_HEADER_SIZE];
+      if (file_size < PACK_HEADER_SIZE ||
+          !read_at(cache->fd, 0, header, sizeof(header)) ||
+          memcmp(header, PACK_MAGIC, 16) != 0 ||
+          get_u32(header + 16) != PACK_VERSION ||
+          get_u32(header + 20) != PACK_HEADER_SIZE) {
+         discarded = "discarded: not a cache file of this version";
+      } else if (memcmp(header + 24, keys_sha1, 20) != 0) {
+         discarded = "discarded: written by another driver build";
+      }
+      if (discarded) {
+         if (!reset_file(cache, keys_sha1)) {
+            set_status("off (cannot rewrite %s: %s)", cache->path,
+                       strerror(errno));
+            return false;
+         }
+      } else {
+         cache->generation = get_u32(header + 44);
+         unsigned indexed = 0, cut_entries = 0, scanned = 0;
+         const char *why = NULL;
+         uint64_t pos = load_idx(cache, file_size, &indexed, &cut_entries, &why);
+         if (why) {
+            /* Rebuilt from the .bin, which a file from before the index gets a
+             * generation for first. */
+            if (cache->generation == 0) {
+               uint8_t g[4];
+               put_u32(g, new_generation(0));
+               if (write_at(cache->fd, 44, g, sizeof(g)))
+                  cache->generation = get_u32(g);
+            }
+            if (cache->generation == 0 || !reset_idx(cache))
+               cache->idx_failed = true;
+         }
+         const uint64_t end = scan_records(cache, pos, file_size, &scanned);
+         records = cache->index->entries; /* without replaced or removed ones */
+         cache->file_size = end;
+         if (why)
+            snprintf(idx_note, sizeof(idx_note),
+                     "; index rebuilt (%s): %u records read one by one%s", why,
+                     scanned, cache->idx_failed ? ", not saved" : "");
+         else {
+            int n = snprintf(idx_note, sizeof(idx_note),
+                             "; index: %u records in one read", indexed);
+            if (scanned && n > 0 && (size_t)n < sizeof(idx_note))
+               n += snprintf(idx_note + n, sizeof(idx_note) - n,
+                             ", %u more read one by one", scanned);
+            if (cut_entries && n > 0 && (size_t)n < sizeof(idx_note))
+               snprintf(idx_note + n, sizeof(idx_note) - n,
+                        ", %u stale entries cut", cut_entries);
+         }
+         if (end < file_size) {
+            cut = file_size - end;
+            if (ftruncate(cache->fd, (off_t)end) != 0) {
+               discarded = "discarded: cannot cut a damaged tail";
+               records = 0;
+               idx_note[0] = '\0';
+               if (!reset_file(cache, keys_sha1)) {
+                  set_status("off (cannot rewrite %s: %s)", cache->path,
+                             strerror(errno));
+                  return false;
+               }
+            }
+         }
+      }
+   }
+
+   const unsigned stale = apply_use(cache);
+   char use_note[96] = "";
+   if (stale)
+      snprintf(use_note, sizeof(use_note), "; %u unused for %u+ runs", stale,
+               cache->prune_boots);
+   const double ms = (os_time_get_nano() - start) / 1e6;
+   char cut_note[64] = "";
+   if (cut)
+      snprintf(cut_note, sizeof(cut_note), "; cut %" PRIu64 " bytes of a damaged tail",
+               cut);
+   set_status("%s: %u entries, %.1f MiB, opened in %.0f ms%s%s%s%s%s; run %u%s (max %" PRIu64
+              " MiB)", cache->path, records, cache->file_size / (1024.0 * 1024.0),
+              ms, idx_note, discarded ? "; " : "", discarded ? discarded : "", cut_note,
+              use_note, cache->boot, recovered ? recovered : "",
+              cache->max_size >> 20);
+   return true;
+}
+
+
+/* ---- maintenance: the .use file and compaction ---- */
+
+char mesa_switch_shader_cache_maintenance_line[512];
+
+static void
+set_maintenance(const char *fmt, ...)
+{
+   va_list args;
+   va_start(args, fmt);
+   vsnprintf(mesa_switch_shader_cache_maintenance_line,
+             sizeof(mesa_switch_shader_cache_maintenance_line), fmt, args);
+   va_end(args);
+}
+
+/* Writes the .use file (one write) if a use changed since the last time. */
+static void
+save_use(struct disk_cache *cache)
+{
+   mtx_lock(&cache->mutex);
+   if (!cache->use_dirty || cache->use_fd < 0) {
+      mtx_unlock(&cache->mutex);
+      return;
+   }
+   const uint32_t count = cache->index->entries;
+   const size_t bytes = USE_HEADER_SIZE + (size_t)count * USE_ENTRY_SIZE;
+   uint8_t *buf = calloc(1, bytes);
+   if (!buf) {
+      mtx_unlock(&cache->mutex);
+      return;
+   }
+   uint8_t *e = buf + USE_HEADER_SIZE;
+   hash_table_foreach(cache->index, he) {
+      const struct pack_entry *entry = he->data;
+      memcpy(e, he->key, CACHE_KEY_SIZE);
+      put_u32(e + 20, entry->last_use);
+      e += USE_ENTRY_SIZE;
+   }
+   cache->use_dirty = false;
+   const int fd = cache->use_fd;
+   const uint32_t boot = cache->boot;
+   mtx_unlock(&cache->mutex);
+
+   memcpy(buf, USE_MAGIC, sizeof(USE_MAGIC));
+   put_u32(buf + 16, USE_VERSION);
+   put_u32(buf + 20, boot);
+   put_u32(buf + 24, count);
+   put_u32(buf + 28, util_hash_crc32(buf + USE_HEADER_SIZE, bytes - USE_HEADER_SIZE));
+   /* A torn write fails the CRC: the next run then counts every entry as
+    * used, which only delays pruning. */
+   if (!write_at(fd, 0, buf, bytes) || ftruncate(fd, (off_t)bytes) != 0) {
+      mtx_lock(&cache->mutex);
+      cache->use_dirty = true;
+      mtx_unlock(&cache->mutex);
+   }
+   free(buf);
+}
+
+struct kept_record {
+   uint8_t key[CACHE_KEY_SIZE];
+   uint64_t offset;      /* of the record, old file; then of the payload, new file */
+   uint32_t size;
+   uint32_t last_use;
+   bool copied;
+};
+
+static int
+compare_offsets(const void *a, const void *b)
+{
+   const struct kept_record *ra = a, *rb = b;
+   return ra->offset < rb->offset ? -1 : ra->offset > rb->offset;
+}
+
+/* Copies the record at offset of in (CRC checked) to out at *pos; the idx
+ * entry goes to entries. Returns the record's length in in (0: no whole
+ * record there; with *damaged set, a record whose payload fails its CRC, not
+ * copied). */
+static uint64_t
+copy_record(int in, uint64_t offset, uint64_t in_size, int out, uint64_t *pos,
+            uint8_t *idx_entry, bool *copied)
+{
+   uint8_t rec[RECORD_HEADER_SIZE];
+   *copied = false;
+   if (offset + RECORD_HEADER_SIZE > in_size || !read_at(in, offset, rec, sizeof(rec)) ||
+       get_u32(rec) != RECORD_MAGIC)
+      return 0;
+   const uint32_t size = get_u32(rec + 24);
+   const uint32_t payload = size == RECORD_TOMBSTONE ? 0 : size;
+   if (offset + RECORD_HEADER_SIZE + payload > in_size)
+      return 0;
+   uint8_t *buf = malloc(RECORD_HEADER_SIZE + payload);
+   if (!buf || !read_at(in, offset, buf, RECORD_HEADER_SIZE + payload)) {
+      free(buf);
+      return 0;
+   }
+   if (!payload || get_u32(buf + 28) == util_hash_crc32(buf + RECORD_HEADER_SIZE, payload)) {
+      if (write_at(out, *pos, buf, RECORD_HEADER_SIZE + payload)) {
+         fill_idx_entry(idx_entry, buf + 4, size, *pos);
+         *pos += RECORD_HEADER_SIZE + payload;
+         *copied = true;
+      } else {
+         free(buf);
+         return 0;
+      }
+   }
+   free(buf);
+   return RECORD_HEADER_SIZE + payload;
+}
+
+/* Compacts the file if enough of it is stale (see the top). force: whatever
+ * the amount (tests). Returns whether it compacted. */
+static bool
+compact(struct disk_cache *cache, bool force)
+{
+   const int64_t start = os_time_get_nano();
+   mtx_lock(&cache->mutex);
+   if (cache->write_failed || cache->fd < 0 || (!cache->prune_boots && !force)) {
+      mtx_unlock(&cache->mutex);
+      return false;
+   }
+   const uint32_t live = cache->index->entries;
+   struct kept_record *kept = malloc(sizeof(*kept) * (live ? live : 1));
+   if (!kept) {
+      mtx_unlock(&cache->mutex);
+      return false;
+   }
+   uint32_t n = 0, stale = 0;
+   uint64_t kept_bytes = PACK_HEADER_SIZE;
+   hash_table_foreach(cache->index, he) {
+      const struct pack_entry *entry = he->data;
+      if (cache->prune_boots && cache->boot - entry->last_use >= cache->prune_boots) {
+         stale++;
+         continue;
+      }
+      memcpy(kept[n].key, he->key, CACHE_KEY_SIZE);
+      kept[n].offset = entry->offset - RECORD_HEADER_SIZE;
+      kept[n].size = entry->size;
+      kept[n].last_use = entry->last_use;
+      kept[n].copied = false;
+      kept_bytes += RECORD_HEADER_SIZE + entry->size;
+      n++;
+   }
+   const uint64_t old_size = cache->file_size;
+   const uint64_t garbage = old_size - kept_bytes;
+   const bool worth = garbage >= PRUNE_MIN_BYTES &&
+                      (garbage * 4 >= old_size || old_size * 4 >= cache->max_size * 3);
+   if (!force && !worth) {
+      mtx_unlock(&cache->mutex);
+      free(kept);
+      return false;
+   }
+   const uint32_t generation = new_generation(cache->generation);
+   mtx_unlock(&cache->mutex);
+
+   /* The copy, without the mutex: its own descriptors, in file order. */
+   qsort(kept, n, sizeof(*kept), compare_offsets);
+   char *bin_tmp = tmp_path(cache, cache->path);
+   char *idx_tmp = tmp_path(cache, cache->idx_path);
+   const char *failed = NULL;
+   int in = open(cache->path, O_RDONLY);
+   int out = open(bin_tmp, O_RDWR | O_CREAT | O_TRUNC, 0644);
+   size_t idx_cap = IDX_HEADER_SIZE + ((size_t)n + 64) * IDX_ENTRY_SIZE;
+   uint8_t *idx = malloc(idx_cap);
+   size_t idx_len = IDX_HEADER_SIZE;
+   uint64_t pos = PACK_HEADER_SIZE;
+   uint32_t damaged = 0;
+   if (in < 0 || out < 0 || !idx) {
+      failed = "cannot open the files";
+   } else {
+      uint8_t header[PACK_HEADER_SIZE] = {0};
+      memcpy(header, PACK_MAGIC, 16);
+      put_u32(header + 16, PACK_VERSION);
+      put_u32(header + 20, PACK_HEADER_SIZE);
+      memcpy(header + 24, cache->keys_sha1, 20);
+      put_u32(header + 44, generation);
+      if (!write_at(out, 0, header, sizeof(header)))
+         failed = "cannot write";
+   }
+   uint64_t since_pause = 0;
+   for (uint32_t i = 0; i < n && !failed; i++) {
+      bool copied;
+      const uint64_t len = copy_record(in, kept[i].offset, old_size, out, &pos,
+                                       idx + idx_len, &copied);
+      if (!len) {
+         failed = "cannot copy a record";
+         break;
+      }
+      if (copied) {
+         kept[i].copied = true;
+         kept[i].offset = pos - kept[i].size; /* the payload, new file */
+         idx_len += IDX_ENTRY_SIZE;
+      } else {
+         damaged++;
+      }
+      /* Small steps: leave the SD card to the application in between. */
+      since_pause += len;
+      if (since_pause >= 512 * 1024) {
+         since_pause = 0;
+         thrd_sleep(&(struct timespec){0, 5000000}, NULL);
+      }
+   }
+
+   /* The swap, under the mutex: the records appended meanwhile, the new
+    * .idx, the files, the index. */
+   mtx_lock(&cache->mutex);
+   uint64_t appended_from = old_size;
+   uint32_t appended = 0;
+   while (!failed && appended_from < cache->file_size) {
+      if (idx_len + IDX_ENTRY_SIZE > idx_cap) {
+         idx_cap *= 2;
+         uint8_t *grown = realloc(idx, idx_cap);
+         if (!grown) {
+            failed = "out of memory";
+            break;
+         }
+         idx = grown;
+      }
+      bool copied;
+      const uint64_t len = copy_record(in, appended_from, cache->file_size, out, &pos,
+                                       idx + idx_len, &copied);
+      if (!len || !copied) {
+         failed = "cannot copy a new record";
+         break;
+      }
+      idx_len += IDX_ENTRY_SIZE;
+      appended_from += len;
+      appended++;
+   }
+   if (!failed) {
+      memcpy(idx, IDX_MAGIC, sizeof(IDX_MAGIC));
+      memset(idx + sizeof(IDX_MAGIC), 0, 16 - sizeof(IDX_MAGIC));
+      put_u32(idx + 16, IDX_VERSION);
+      put_u32(idx + 20, IDX_HEADER_SIZE);
+      put_u32(idx + 24, generation);
+      put_u32(idx + 28, util_hash_crc32(idx, 28));
+      int idx_fd = open(idx_tmp, O_RDWR | O_CREAT | O_TRUNC, 0644);
+      if (idx_fd < 0 || !write_at(idx_fd, 0, idx, idx_len))
+         failed = "cannot write the index";
+      if (idx_fd >= 0)
+         close(idx_fd);
+   }
+   if (out >= 0)
+      close(out);
+   if (in >= 0)
+      close(in);
+   if (failed) {
+      unlink(bin_tmp);
+      unlink(idx_tmp);
+      mtx_unlock(&cache->mutex);
+      set_maintenance("compaction failed (%s); the file is unchanged", failed);
+   } else {
+      /* Replace the files: from here a stop leaves .tmp files the next start
+       * takes (recover_tmp_files). */
+      close(cache->fd);
+      cache->fd = -1;
+      if (cache->idx_fd >= 0)
+         close(cache->idx_fd);
+      cache->idx_fd = -1;
+      unlink(cache->idx_path);
+      unlink(cache->path);
+      const bool renamed = rename(bin_tmp, cache->path) == 0;
+      if (renamed && rename(idx_tmp, cache->idx_path) != 0) {
+         /* The next start rebuilds the index. */
+      }
+      cache->fd = open(renamed ? cache->path : bin_tmp, O_RDWR);
+      cache->idx_fd = open(cache->idx_path, O_RDWR);
+      cache->idx_size = idx_len;
+      cache->idx_failed = cache->idx_fd < 0;
+      if (cache->fd < 0) {
+         cache->write_failed = true; /* gets miss; the next start recovers */
+      }
+      cache->generation = generation;
+      cache->file_size = pos;
+
+      /* The index: the kept records, then the appended ones in order. */
+      struct hash_table *old = cache->index;
+      cache->index = _mesa_hash_table_create(cache, key_hash, key_equals);
+      for (uint32_t i = 0; i < n; i++) {
+         if (!kept[i].copied)
+            continue;
+         index_set(cache, kept[i].key, kept[i].offset, kept[i].size);
+         struct hash_entry *he = _mesa_hash_table_search(cache->index, kept[i].key);
+         /* Its use as of now (a get during the copy may have marked it). */
+         struct hash_entry *was = _mesa_hash_table_search(old, kept[i].key);
+         if (he)
+            ((struct pack_entry *)he->data)->last_use =
+               was ? ((struct pack_entry *)was->data)->last_use : kept[i].last_use;
+      }
+      const uint8_t *e = idx + idx_len - (size_t)appended * IDX_ENTRY_SIZE;
+      for (uint32_t i = 0; i < appended; i++, e += IDX_ENTRY_SIZE) {
+         const uint32_t size = get_u32(e + 24);
+         const uint64_t offset = get_u32(e + 28) | ((uint64_t)get_u32(e + 32) << 32);
+         if (size == RECORD_TOMBSTONE)
+            index_remove(cache, e + 4);
+         else
+            index_set(cache, e + 4, offset + RECORD_HEADER_SIZE, size);
+      }
+      _mesa_hash_table_destroy(old, NULL);
+      cache->use_dirty = true;
+      const uint32_t entries = cache->index->entries;
+      const uint64_t new_size = cache->file_size;
+      mtx_unlock(&cache->mutex);
+      char damaged_note[48] = "";
+      if (damaged)
+         snprintf(damaged_note, sizeof(damaged_note), ", %u damaged dropped", damaged);
+      set_maintenance("compacted %s in %.0f ms: %u of %u entries kept, %u unused for "
+                      "%u+ runs dropped%s, %.1f MiB -> %.1f MiB (run %u)",
+                      cache->path, (os_time_get_nano() - start) / 1e6, entries, live,
+                      stale, cache->prune_boots, damaged_note, old_size / (1024.0 * 1024.0),
+                      new_size / (1024.0 * 1024.0), cache->boot);
+   }
+   free(idx);
+   free(kept);
+   ralloc_free(bin_tmp);
+   ralloc_free(idx_tmp);
+   return !failed;
+}
+
+/* The maintenance thread: the .use file every MAINT_PERIOD_S seconds, and one
+ * compaction check MESA_SHADER_CACHE_PRUNE_DELAY seconds after creation. */
+static int
+maintenance_thread(void *arg)
+{
+   struct disk_cache *cache = arg;
+   bool checked = false;
+   mtx_lock(&cache->maint_mutex);
+   while (!cache->maint_stop) {
+      struct timespec until;
+      timespec_get(&until, TIME_UTC);
+      until.tv_sec += MAINT_PERIOD_S;
+      cnd_timedwait(&cache->maint_cnd, &cache->maint_mutex, &until);
+      if (cache->maint_stop)
+         break;
+      mtx_unlock(&cache->maint_mutex);
+      if (!checked &&
+          (uint64_t)(os_time_get_nano() - cache->created_ns) >= cache->prune_delay_ns) {
+         checked = true;
+         compact(cache, false);
+      }
+      save_use(cache);
+      mtx_lock(&cache->maint_mutex);
+   }
+   mtx_unlock(&cache->maint_mutex);
+   return 0;
+}
+
+static void
+start_maintenance(struct disk_cache *cache)
+{
+   if (mtx_init(&cache->maint_mutex, mtx_plain) != thrd_success)
+      return;
+   if (cnd_init(&cache->maint_cnd) != thrd_success) {
+      mtx_destroy(&cache->maint_mutex);
+      return;
+   }
+   cache->maint_running =
+      thrd_create(&cache->maint_thread, maintenance_thread, cache) == thrd_success;
+   if (!cache->maint_running) {
+      cnd_destroy(&cache->maint_cnd);
+      mtx_destroy(&cache->maint_mutex);
+   }
+}
+
+static void
+stop_maintenance(struct disk_cache *cache)
+{
+   if (!cache->maint_running)
+      return;
+   mtx_lock(&cache->maint_mutex);
+   cache->maint_stop = true;
+   cnd_broadcast(&cache->maint_cnd);
+   mtx_unlock(&cache->maint_mutex);
+   thrd_join(cache->maint_thread, NULL);
+   cnd_destroy(&cache->maint_cnd);
+   mtx_destroy(&cache->maint_mutex);
+   cache->maint_running = false;
+}
+
+/* For tests, what the maintenance thread does at once: mode 1 compacts if
+ * enough is stale (as the thread's check), 2 whatever the amount, 0 not;
+ * then writes the .use file. Returns whether it compacted. */
+bool
+disk_cache_switch_maintain(struct disk_cache *cache, int mode);
+bool
+disk_cache_switch_maintain(struct disk_cache *cache, int mode)
+{
+   const bool compacted = mode && compact(cache, mode == 2);
+   save_use(cache);
+   return compacted;
+}
+
+struct disk_cache *
+disk_cache_create(const char *gpu_name, const char *driver_id,
+                  uint64_t driver_flags)
+{
+   if (env_var_as_boolean("MESA_GLSL_CACHE_DISABLE", false) ||
+       env_var_as_boolean("MESA_SHADER_CACHE_DISABLE", false)) {
+      set_status("off (MESA_SHADER_CACHE_DISABLE)");
+      return NULL;
+   }
+   const char *dir = getenv("MESA_SHADER_CACHE_DIR");
+   if (!dir || !*dir)
+      dir = getenv("MESA_GLSL_CACHE_DIR");
+   if (!dir || !*dir) {
+      set_status("off (MESA_SHADER_CACHE_DIR not set)");
+      return NULL;
+   }
+
+   struct disk_cache *cache = rzalloc(NULL, struct disk_cache);
+   if (!cache)
+      return NULL;
+   if (mtx_init(&cache->mutex, mtx_plain) != thrd_success) {
+      ralloc_free(cache);
+      return NULL;
+   }
+   cache->fd = -1;
+   cache->idx_fd = -1;
+   cache->use_fd = -1;
+   cache->prune_boots = read_env_u32("MESA_SHADER_CACHE_PRUNE_BOOTS", DEFAULT_PRUNE_BOOTS);
+   cache->prune_delay_ns = (uint64_t)read_env_u32("MESA_SHADER_CACHE_PRUNE_DELAY",
+                                                  DEFAULT_PRUNE_DELAY_S) * 1000000000ull;
+   cache->created_ns = os_time_get_nano();
+   cache->index = _mesa_hash_table_create(cache, key_hash, key_equals);
+   cache->max_size = read_max_size();
+
+   /* The driver keys, as disk_cache.c builds them. */
+   uint8_t cache_version = CACHE_VERSION;
+   uint8_t ptr_size = sizeof(void *);
+   size_t id_size = strlen(driver_id) + 1;
+   size_t gpu_name_size = strlen(gpu_name) + 1;
+   cache->driver_keys_blob_size = sizeof(cache_version) + id_size +
+                                  gpu_name_size + sizeof(ptr_size) +
+                                  sizeof(driver_flags);
+   cache->driver_keys_blob = ralloc_size(cache, cache->driver_keys_blob_size);
+   if (!cache->index || !cache->driver_keys_blob)
+      goto fail;
+   uint8_t *p = cache->driver_keys_blob;
+   memcpy(p, &cache_version, sizeof(cache_version)); p += sizeof(cache_version);
+   memcpy(p, driver_id, id_size); p += id_size;
+   memcpy(p, gpu_name, gpu_name_size); p += gpu_name_size;
+   memcpy(p, &ptr_size, sizeof(ptr_size)); p += sizeof(ptr_size);
+   memcpy(p, &driver_flags, sizeof(driver_flags));
+
+   if (!open_pack(cache, dir))
+      goto fail;
+   start_maintenance(cache);
+   return cache;
+
+fail:
+   if (cache->fd >= 0)
+      close(cache->fd);
+   if (cache->idx_fd >= 0)
+      close(cache->idx_fd);
+   if (cache->use_fd >= 0)
+      close(cache->use_fd);
+   mtx_destroy(&cache->mutex);
+   ralloc_free(cache);
+   return NULL;
+}
+
+void
+disk_cache_destroy(struct disk_cache *cache)
+{
+   if (!cache)
+      return;
+   stop_maintenance(cache);
+   save_use(cache);
+   if (cache->fd >= 0)
+      close(cache->fd);
+   if (cache->idx_fd >= 0)
+      close(cache->idx_fd);
+   if (cache->use_fd >= 0)
+      close(cache->use_fd);
+   mtx_destroy(&cache->mutex);
+   ralloc_free(cache);
+}
+
+void
+disk_cache_wait_for_idle(struct disk_cache *cache)
+{
+   (void)cache; /* writes are synchronous */
+}
+
+/* Appends a record (size RECORD_TOMBSTONE: a tombstone, no payload). Called
+ * with the mutex held. */
+static bool
+append_record(struct disk_cache *cache, const cache_key key, const void *data,
+              uint32_t size)
+{
+   const uint32_t payload = size == RECORD_TOMBSTONE ? 0 : size;
+   if (cache->write_failed)
+      return false;
+   if (cache->file_size + RECORD_HEADER_SIZE + payload > cache->max_size) {
+      mesa_switch_stat_add(MESA_SWITCH_CACHE_PUTS_DROPPED, 1);
+      return false;
+   }
+   uint8_t *rec = malloc(RECORD_HEADER_SIZE + payload);
+   if (!rec)
+      return false;
+   put_u32(rec, RECORD_MAGIC);
+   memcpy(rec + 4, key, CACHE_KEY_SIZE);
+   put_u32(rec + 24, size);
+   put_u32(rec + 28, payload ? util_hash_crc32(data, payload) : 0);
+   if (payload)
+      memcpy(rec + RECORD_HEADER_SIZE, data, payload);
+
+   const uint64_t start = cache->file_size;
+   const bool ok = write_at(cache->fd, start, rec, RECORD_HEADER_SIZE + payload);
+   free(rec);
+   if (!ok) {
+      /* Leave a whole file behind (a torn record would be cut at the next
+       * start anyway) and stop writing for this run. */
+      cache->write_failed = true;
+      if (ftruncate(cache->fd, (off_t)start) != 0) {
+         /* The next start cuts the torn record. */
+      }
+      mesa_switch_stat_add(MESA_SWITCH_CACHE_PUTS_DROPPED, 1);
+      return false;
+   }
+   cache->file_size = start + RECORD_HEADER_SIZE + payload;
+   /* Then its entry in the .idx (after the record: an entry never names a
+    * record that was not written). */
+   uint8_t entry[IDX_ENTRY_SIZE];
+   fill_idx_entry(entry, key, size, start);
+   idx_append(cache, entry, sizeof(entry));
+   return true;
+}
+
+static void
+pack_put(struct disk_cache *cache, const cache_key key, const void *data,
+         size_t size)
+{
+   if (size >= RECORD_TOMBSTONE)
+      return;
+   const int64_t start = os_time_get_nano();
+   mtx_lock(&cache->mutex);
+   struct hash_entry *he = _mesa_hash_table_search(cache->index, key);
+   if (he)
+      mark_used(cache, he->data);
+   if (!he && append_record(cache, key, data, (uint32_t)size)) {
+      index_set(cache, key, cache->file_size - size, (uint32_t)size);
+      mesa_switch_stat_add(MESA_SWITCH_CACHE_PUTS, 1);
+      mesa_switch_stat_add(MESA_SWITCH_CACHE_PUT_BYTES, RECORD_HEADER_SIZE + size);
+   }
+   mtx_unlock(&cache->mutex);
+   mesa_switch_stat_add(MESA_SWITCH_CACHE_PUT_NS, os_time_get_nano() - start);
+}
+
+void
+disk_cache_remove(struct disk_cache *cache, const cache_key key)
+{
+   mtx_lock(&cache->mutex);
+   if (_mesa_hash_table_search(cache->index, key)) {
+      index_remove(cache, key);
+      append_record(cache, key, NULL, RECORD_TOMBSTONE);
+   }
+   mtx_unlock(&cache->mutex);
+}
+
+void
+disk_cache_put(struct disk_cache *cache, const cache_key key,
+               const void *data, size_t size,
+               struct cache_item_metadata *cache_item_metadata)
+{
+   (void)cache_item_metadata;
+   if (cache->blob_put_cb) {
+      cache->blob_put_cb(key, CACHE_KEY_SIZE, data, size);
+      return;
+   }
+   pack_put(cache, key, data, size);
+}
+
+void *
+disk_cache_get(struct disk_cache *cache, const cache_key key, size_t *size)
+{
+   if (size)
+      *size = 0;
+
+   if (cache->blob_get_cb) {
+      signed long max_blob_size = 64 * 1024;
+      void *blob = malloc(max_blob_size);
+      if (!blob)
+         return NULL;
+      signed long bytes =
+         cache->blob_get_cb(key, CACHE_KEY_SIZE, blob, max_blob_size);
+      if (bytes > max_blob_size) {
+         /* EGL_ANDROID_blob_cache: the size of a value too large to copy. */
+         void *larger = realloc(blob, bytes);
+         if (!larger) {
+            free(blob);
+            return NULL;
+         }
+         blob = larger;
+         max_blob_size = bytes;
+         bytes = cache->blob_get_cb(key, CACHE_KEY_SIZE, blob, max_blob_size);
+      }
+      if (bytes <= 0 || bytes > max_blob_size) {
+         free(blob);
+         return NULL;
+      }
+      if (size)
+         *size = bytes;
+      return blob;
+   }
+
+   const int64_t start = os_time_get_nano();
+   void *data = NULL;
+   mesa_switch_stat_add(MESA_SWITCH_CACHE_GETS, 1);
+   mtx_lock(&cache->mutex);
+   struct hash_entry *he = _mesa_hash_table_search(cache->index, key);
+   if (he) {
+      const struct pack_entry *entry = he->data;
+      /* The record's header and payload in one read; the payload is moved
+       * to the front of the buffer the caller frees. */
+      uint8_t *rec = malloc(RECORD_HEADER_SIZE + entry->size);
+      bool ok = rec &&
+                read_at(cache->fd, entry->offset - RECORD_HEADER_SIZE, rec,
+                        RECORD_HEADER_SIZE + entry->size) &&
+                get_u32(rec) == RECORD_MAGIC &&
+                memcmp(rec + 4, key, CACHE_KEY_SIZE) == 0 &&
+                get_u32(rec + 24) == entry->size &&
+                get_u32(rec + 28) ==
+                   (entry->size ? util_hash_crc32(rec + RECORD_HEADER_SIZE,
+                                                  entry->size) : 0);
+      if (ok) {
+         memmove(rec, rec + RECORD_HEADER_SIZE, entry->size);
+         data = rec;
+      } else {
+         free(rec);
+      }
+      if (ok) {
+         if (size)
+            *size = entry->size;
+         mark_used(cache, he->data);
+         mesa_switch_stat_add(MESA_SWITCH_CACHE_GET_HITS, 1);
+      } else {
+         /* A damaged entry is a miss, and is forgotten for this run (its
+          * replacement is appended after it, which a later scan prefers). */
+         data = NULL;
+         index_remove(cache, key);
+         mesa_switch_stat_add(MESA_SWITCH_CACHE_CORRUPT, 1);
+      }
+   }
+   mtx_unlock(&cache->mutex);
+   mesa_switch_stat_add(MESA_SWITCH_CACHE_GET_NS, os_time_get_nano() - start);
+   return data;
+}
+
+void
+disk_cache_put_key(struct disk_cache *cache, const cache_key key)
+{
+   if (cache->blob_put_cb) {
+      const uint32_t *key_chunk = (const uint32_t *) key;
+      cache->blob_put_cb(key, CACHE_KEY_SIZE, key_chunk, sizeof(uint32_t));
+      return;
+   }
+   pack_put(cache, key, NULL, 0);
+}
+
+bool
+disk_cache_has_key(struct disk_cache *cache, const cache_key key)
+{
+   if (cache->blob_get_cb) {
+      uint32_t blob;
+      return cache->blob_get_cb(key, CACHE_KEY_SIZE, &blob, sizeof(uint32_t));
+   }
+   mtx_lock(&cache->mutex);
+   struct hash_entry *he = _mesa_hash_table_search(cache->index, key);
+   const bool found = he != NULL;
+   if (he)
+      mark_used(cache, he->data);
+   mtx_unlock(&cache->mutex);
+   mesa_switch_stat_add(found ? MESA_SWITCH_CACHE_HAS_KEY_HITS
+                              : MESA_SWITCH_CACHE_HAS_KEY_MISSES, 1);
+   return found;
+}
+
+void
+disk_cache_compute_key(struct disk_cache *cache, const void *data, size_t size,
+                       cache_key key)
+{
+   struct mesa_sha1 ctx;
+
+   _mesa_sha1_init(&ctx);
+   _mesa_sha1_update(&ctx, cache->driver_keys_blob,
+                     cache->driver_keys_blob_size);
+   _mesa_sha1_update(&ctx, data, size);
+   _mesa_sha1_final(&ctx, key);
+}
+
+void
+disk_cache_set_callbacks(struct disk_cache *cache, disk_cache_put_cb put,
+                         disk_cache_get_cb get)
+{
+   cache->blob_put_cb = put;
+   cache->blob_get_cb = get;
+}
+
+#else
+char mesa_switch_shader_cache_maintenance_line[512];
+#endif /* ENABLE_SHADER_CACHE && (__SWITCH__ || MESA_DISK_CACHE_SINGLE_FILE) */
+
+/* The last compaction of the Horizon cache ("" if none yet this run). */
+const char *mesa_switch_shader_cache_maintenance(void);
+const char *
+mesa_switch_shader_cache_maintenance(void)
+{
+   return mesa_switch_shader_cache_maintenance_line;
+}
