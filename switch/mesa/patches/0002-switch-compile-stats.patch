diff --git a/src/util/u_switch_stats.c b/src/util/u_switch_stats.c
new file mode 100644
index 0000000..317284e
--- /dev/null
+++ b/src/util/u_switch_stats.c
@@ -0,0 +1,25 @@
+#include <string.h>
+
+#include "util/u_switch_stats.h"
+
+uint64_t mesa_switch_stats[MESA_SWITCH_STAT_COUNT];
+
+unsigned
+mesa_switch_get_stats(uint64_t *out, unsigned count)
+{
+   if (out) {
+      if (count > MESA_SWITCH_STAT_COUNT)
+         count = MESA_SWITCH_STAT_COUNT;
+      for (unsigned i = 0; i < count; i++)
+         out[i] = p_atomic_read(&mesa_switch_stats[i]);
+   }
+   return MESA_SWITCH_STAT_COUNT;
+}
+
+char mesa_switch_shader_cache_status_line[512] = "off (no shader cache in this build)";
+
+const char *
+mesa_switch_shader_cache_status(void)
+{
+   return mesa_switch_shader_cache_status_line;
+}
diff --git a/src/util/u_switch_stats.h b/src/util/u_switch_stats.h
new file mode 100644
index 0000000..c6cc11f
--- /dev/null
+++ b/src/util/u_switch_stats.h
@@ -0,0 +1,33 @@
+/* Counters behind include/mesa_switch.h (Switch builds; harmless elsewhere). */
+#ifndef U_SWITCH_STATS_H
+#define U_SWITCH_STATS_H
+
+#include "mesa_switch.h"
+#include "util/os_time.h"
+#include "util/u_atomic.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+extern uint64_t mesa_switch_stats[MESA_SWITCH_STAT_COUNT];
+/* What mesa_switch_shader_cache_status returns; written by the disk cache when it is created. */
+extern char mesa_switch_shader_cache_status_line[512];
+
+static inline void
+mesa_switch_stat_add(enum mesa_switch_stat stat, uint64_t value)
+{
+   p_atomic_add(&mesa_switch_stats[stat], value);
+}
+
+static inline uint64_t
+mesa_switch_stat_read(enum mesa_switch_stat stat)
+{
+   return p_atomic_read(&mesa_switch_stats[stat]);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
