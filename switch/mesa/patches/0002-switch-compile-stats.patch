Counters and timers of where shader compilation goes, for the application's log
(include/mesa_switch.h, mesa_switch_get_stats): glCompileShader (and the compiles the GLSL cache
deferred), glLinkProgram split into the GLSL linker and the state tracker's LinkShader (GLSL IR to
TGSI plus the variant nvc0 builds at link time), nvc0_program_translate (TGSI to machine code),
glProgramBinary/glGetProgramBinary, and the disk cache's gets and puts (filled by 0003).

diff --git a/include/mesa_switch.h b/include/mesa_switch.h
new file mode 100644
index 0000000..fd9287d
--- /dev/null
+++ b/include/mesa_switch.h
@@ -0,0 +1,68 @@
+/*
+ * Switch (Horizon) build of Mesa 20.1 for centollOS (switch/mesa in that
+ * repository): counters and timers of the GLSL compiler, the state tracker and nvc0's code
+ * generator, and the state of the persistent shader cache, read by the application for its log.
+ * Public header: the build copies it into the install prefix's include directory.
+ */
+#ifndef MESA_SWITCH_H
+#define MESA_SWITCH_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define MESA_SWITCH_STATS_VERSION 1
+
+enum mesa_switch_stat {
+   /* glCompileShader (_mesa_glsl_compile_shader): calls, time, and calls the disk cache let it
+    * defer (the shader is compiled later only if the link misses the cache). */
+   MESA_SWITCH_GLSL_COMPILES,
+   MESA_SWITCH_GLSL_COMPILE_NS,
+   MESA_SWITCH_GLSL_COMPILES_SKIPPED,
+   /* glLinkProgram (_mesa_glsl_link_shader): calls and total time; of that, the GLSL linker
+    * (link_shaders, without the deferred compiles it runs), the driver's LinkShader (st: GLSL IR
+    * to TGSI and, for drivers with shareable shaders such as nvc0, the variant whose code
+    * generation is counted below), and links the GLSL cache satisfied. */
+   MESA_SWITCH_LINKS,
+   MESA_SWITCH_LINK_NS,
+   MESA_SWITCH_LINK_GLSL_NS,
+   MESA_SWITCH_LINK_ST_NS,
+   MESA_SWITCH_LINKS_FROM_CACHE,
+   /* nvc0_program_translate: TGSI to machine code (nv50_ir) and header, wherever it runs. */
+   MESA_SWITCH_NVC0_TRANSLATES,
+   MESA_SWITCH_NVC0_TRANSLATE_NS,
+   MESA_SWITCH_NVC0_CACHE_HITS,
+   /* glProgramBinary / glGetProgramBinary. */
+   MESA_SWITCH_BINARY_LOADS,
+   MESA_SWITCH_BINARY_LOAD_FAILS,
+   MESA_SWITCH_BINARY_LOAD_NS,
+   MESA_SWITCH_BINARY_SAVES,
+   MESA_SWITCH_BINARY_SAVE_NS,
+   /* The persistent shader cache (disk_cache on Horizon: one file, see disk_cache.c). */
+   MESA_SWITCH_CACHE_GETS,
+   MESA_SWITCH_CACHE_GET_HITS,
+   MESA_SWITCH_CACHE_GET_NS,
+   MESA_SWITCH_CACHE_CORRUPT,
+   MESA_SWITCH_CACHE_PUTS,
+   MESA_SWITCH_CACHE_PUT_BYTES,
+   MESA_SWITCH_CACHE_PUT_NS,
+   MESA_SWITCH_CACHE_PUTS_DROPPED,
+   MESA_SWITCH_CACHE_HAS_KEY_HITS,
+   MESA_SWITCH_CACHE_HAS_KEY_MISSES,
+   MESA_SWITCH_STAT_COUNT
+};
+
+/* Copies min(count, MESA_SWITCH_STAT_COUNT) running totals to out; returns MESA_SWITCH_STAT_COUNT. */
+unsigned mesa_switch_get_stats(uint64_t *out, unsigned count);
+
+/* One line on the persistent shader cache's state ("off", or its file, entries and what was
+ * discarded at load), for the application's log. Never NULL. */
+const char *mesa_switch_shader_cache_status(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
