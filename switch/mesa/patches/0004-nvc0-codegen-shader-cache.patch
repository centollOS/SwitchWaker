--- /dev/null
+++ b/src/gallium/drivers/nouveau/codegen/nv50_ir_switch_cache.cpp
@@ -0,0 +1,109 @@
+/*
+ * Switch shader cache (nvc0_program.c): the relocation and fixup tables of a
+ * translated program, written to and read from a cache blob. The fixup entries
+ * carry function pointers (the emitters' interpolation and selp fixups), which
+ * are stored as indices into the emitters' tables (the address changes from run
+ * to run). Backported in spirit from Mesa 20.3's nv50_ir_serialize.cpp, without
+ * its split of nv50_ir_prog_info.
+ */
+#include "util/blob.h"
+#include "util/u_memory.h"
+
+#include "codegen/nv50_ir_target.h"
+#include "codegen/nv50_ir_switch_cache.h"
+
+namespace nv50_ir {
+FixupApply gm107_fixupApplyByIndex(int index);
+}
+
+using namespace nv50_ir;
+
+static FixupApply
+apply_by_id(int id)
+{
+   /* The Switch's Maxwell (GM20B) uses the GM107 emitter; the Fermi and Kepler
+    * emitters are compiled out of this build, so their programs are not cached. */
+   return gm107_fixupApplyByIndex(id);
+}
+
+static int
+id_of_apply(FixupApply apply)
+{
+   for (int id = 0; id < 2; id++)
+      if (apply_by_id(id) == apply)
+         return id;
+   return -1;
+}
+
+extern "C" bool
+nv50_ir_switch_write_relocs_fixups(struct blob *blob, const void *relocs,
+                                   const void *fixups)
+{
+   const RelocInfo *reloc = (const RelocInfo *)relocs;
+   if (!reloc) {
+      blob_write_uint32(blob, 0);
+   } else {
+      blob_write_uint32(blob, reloc->count + 1);
+      blob_write_uint32(blob, reloc->codePos);
+      blob_write_uint32(blob, reloc->libPos);
+      blob_write_uint32(blob, reloc->dataPos);
+      blob_write_bytes(blob, reloc->entry, sizeof(*reloc->entry) * reloc->count);
+   }
+   const FixupInfo *fixup = (const FixupInfo *)fixups;
+   if (!fixup) {
+      blob_write_uint32(blob, 0);
+   } else {
+      blob_write_uint32(blob, fixup->count + 1);
+      for (uint32_t i = 0; i < fixup->count; i++) {
+         const int id = id_of_apply(fixup->entry[i].apply);
+         if (id < 0)
+            return false; /* an unknown fixup: do not cache this program */
+         blob_write_uint32(blob, fixup->entry[i].val);
+         blob_write_uint8(blob, (uint8_t)id);
+      }
+   }
+   return !blob->out_of_memory;
+}
+
+extern "C" bool
+nv50_ir_switch_read_relocs_fixups(struct blob_reader *reader, void **relocs,
+                                  void **fixups)
+{
+   *relocs = NULL;
+   *fixups = NULL;
+   uint32_t count = blob_read_uint32(reader);
+   if (count) {
+      count--;
+      if (count > (1u << 20))
+         return false;
+      RelocInfo *reloc = (RelocInfo *)
+         CALLOC(1, sizeof(RelocInfo) + count * sizeof(RelocEntry));
+      if (!reloc)
+         return false;
+      reloc->codePos = blob_read_uint32(reader);
+      reloc->libPos = blob_read_uint32(reader);
+      reloc->dataPos = blob_read_uint32(reader);
+      reloc->count = count;
+      blob_copy_bytes(reader, reloc->entry, sizeof(RelocEntry) * count);
+      *relocs = reloc;
+   }
+   count = blob_read_uint32(reader);
+   if (count) {
+      count--;
+      if (count > (1u << 20))
+         return false;
+      FixupInfo *fixup = (FixupInfo *)
+         CALLOC(1, sizeof(FixupInfo) + count * sizeof(FixupEntry));
+      if (!fixup)
+         return false;
+      fixup->count = count;
+      *fixups = fixup;
+      for (uint32_t i = 0; i < count; i++) {
+         fixup->entry[i].val = blob_read_uint32(reader);
+         fixup->entry[i].apply = apply_by_id(blob_read_uint8(reader));
+         if (!fixup->entry[i].apply)
+            return false;
+      }
+   }
+   return !reader->overrun;
+}
