 /* NOTE: Using a[0x270] in FP may cause an error even if we're using less than
@@ -573,12 +577,141 @@ static bool
 program_translate(struct nvc0_program *prog, uint16_t chipset,
                   struct pipe_debug_callback *debug);
 
+/*
+ * Shader disk cache for nvc0's code generation (Switch port; upstream added one
+ * in Mesa 20.3 with a different layout). The result of program_translate (code,
+ * header, relocations, fixups and the state the header generators set) is kept
+ * under a key made of everything it reads: chipset, stage, TGSI tokens, user
+ * clip planes and shared memory size, plus the driver keys disk_cache_compute_key
+ * adds. Compute shaders and programs with stream output are not cached.
+ */
+#define NVC0_PROGRAM_CACHE_VERSION 1
+
+static bool
+program_cache_key(struct nvc0_program *prog, uint16_t chipset,
+                  struct disk_cache *cache, cache_key key)
+{
+   if (!cache || prog->type == PIPE_SHADER_COMPUTE ||
+       prog->pipe.type != PIPE_SHADER_IR_TGSI || !prog->pipe.tokens ||
+       prog->pipe.stream_output.num_outputs)
+      return false;
+   struct blob blob;
+   blob_init(&blob);
+   blob_write_string(&blob, "nvc0_program_translate");
+   blob_write_uint32(&blob, NVC0_PROGRAM_CACHE_VERSION);
+   blob_write_uint32(&blob, chipset);
+   blob_write_uint32(&blob, prog->type);
+   blob_write_uint32(&blob, prog->vp.num_ucps);
+   blob_write_uint32(&blob, prog->cp.smem_size);
+   blob_write_bytes(&blob, prog->pipe.tokens,
+                    tgsi_num_tokens(prog->pipe.tokens) * sizeof(struct tgsi_token));
+   const bool ok = !blob.out_of_memory;
+   if (ok)
+      disk_cache_compute_key(cache, blob.data, blob.size, key);
+   blob_finish(&blob);
+   return ok;
+}
+
+static void
+program_cache_store(struct nvc0_program *prog, struct disk_cache *cache,
+                    const cache_key key)
+{
+   struct blob blob;
+   blob_init(&blob);
+   blob_write_uint32(&blob, NVC0_PROGRAM_CACHE_VERSION);
+   blob_write_uint8(&blob, prog->need_tls);
+   blob_write_uint8(&blob, prog->num_gprs);
+   blob_write_uint8(&blob, prog->num_barriers);
+   blob_write_uint32(&blob, prog->cp.smem_size);
+   blob_write_uint32(&blob, prog->code_size);
+   blob_write_bytes(&blob, prog->code, prog->code_size);
+   blob_write_bytes(&blob, prog->hdr, sizeof(prog->hdr));
+   blob_write_bytes(&blob, prog->flags, sizeof(prog->flags));
+   blob_write_bytes(&blob, &prog->vp, sizeof(prog->vp));
+   blob_write_bytes(&blob, &prog->fp, sizeof(prog->fp));
+   blob_write_bytes(&blob, &prog->tp, sizeof(prog->tp));
+   if (nv50_ir_switch_write_relocs_fixups(&blob, prog->relocs, prog->fixups) &&
+       !blob.out_of_memory)
+      disk_cache_put(cache, key, blob.data, blob.size, NULL);
+   blob_finish(&blob);
+}
+
+static bool
+program_cache_load(struct nvc0_program *prog, struct disk_cache *cache,
+                   const cache_key key)
+{
+   size_t size = 0;
+   void *data = disk_cache_get(cache, key, &size);
+   if (!data)
+      return false;
+   struct blob_reader reader;
+   blob_reader_init(&reader, data, size);
+   bool ok = blob_read_uint32(&reader) == NVC0_PROGRAM_CACHE_VERSION;
+   const bool need_tls = blob_read_uint8(&reader);
+   const uint8_t num_gprs = blob_read_uint8(&reader);
+   const uint8_t num_barriers = blob_read_uint8(&reader);
+   const uint32_t smem_size = blob_read_uint32(&reader);
+   const uint32_t code_size = blob_read_uint32(&reader);
+   ok = ok && !reader.overrun && code_size <= size;
+   uint32_t *code = NULL;
+   if (ok && code_size) {
+      code = MALLOC(code_size);
+      ok = code != NULL;
+      if (ok)
+         blob_copy_bytes(&reader, code, code_size);
+   }
+   uint32_t hdr[20], flags[2];
+   __typeof__(prog->vp) vp;
+   __typeof__(prog->fp) fp;
+   __typeof__(prog->tp) tp;
+   blob_copy_bytes(&reader, hdr, sizeof(hdr));
+   blob_copy_bytes(&reader, flags, sizeof(flags));
+   blob_copy_bytes(&reader, &vp, sizeof(vp));
+   blob_copy_bytes(&reader, &fp, sizeof(fp));
+   blob_copy_bytes(&reader, &tp, sizeof(tp));
+   void *relocs = NULL, *fixups = NULL;
+   ok = ok && nv50_ir_switch_read_relocs_fixups(&reader, &relocs, &fixups) &&
+        !reader.overrun && reader.current == reader.end;
+   free(data);
+   if (!ok) {
+      FREE(code);
+      FREE(relocs);
+      FREE(fixups);
+      return false;
+   }
+   prog->need_tls = need_tls;
+   prog->num_gprs = num_gprs;
+   prog->num_barriers = num_barriers;
+   prog->cp.smem_size = smem_size;
+   prog->code = code;
+   prog->code_size = code_size;
+   memcpy(prog->hdr, hdr, sizeof(hdr));
+   memcpy(prog->flags, flags, sizeof(flags));
+   prog->vp = vp;
+   prog->fp = fp;
+   prog->tp = tp;
+   prog->relocs = relocs;
+   prog->fixups = fixups;
+   return true;
+}
+
 bool
 nvc0_program_translate(struct nvc0_program *prog, uint16_t chipset,
+                       struct disk_cache *disk_shader_cache,
                        struct pipe_debug_callback *debug)
 {
    const int64_t start = os_time_get_nano();
-   const bool ok = program_translate(prog, chipset, debug);
+   cache_key key;
+   const bool cacheable = program_cache_key(prog, chipset, disk_shader_cache, key);
+   bool ok;
+   if (cacheable && program_cache_load(prog, disk_shader_cache, key)) {
+      ok = true;
+      mesa_switch_stat_add(MESA_SWITCH_NVC0_CACHE_HITS, 1);
+   } else {
+      ok = program_translate(prog, chipset, debug);
+      if (ok && cacheable)
+         program_cache_store(prog, disk_shader_cache, key);
+   }
    mesa_switch_stat_add(MESA_SWITCH_NVC0_TRANSLATE_NS, os_time_get_nano() - start);
    mesa_switch_stat_add(MESA_SWITCH_NVC0_TRANSLATES, 1);
    return ok;
