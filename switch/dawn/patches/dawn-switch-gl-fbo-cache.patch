--- /dev/null
+++ b/src/dawn/native/opengl/SwitchFboCacheGL.h
@@ -0,0 +1,140 @@
+// Switch only (switch/dawn/patches/dawn-switch-gl-fbo-cache.patch), opt-in with
+// COS_SWITCH_GL_FBO_CACHE=1 (an A/B option of the native port; docs/SWITCH_PERF_STUDY.md, option c):
+// ExecuteRenderPass keeps its framebuffer objects, keyed by their attachments (GL texture name,
+// mip level, layer and attachment point), instead of glGenFramebuffers + glFramebufferTexture2D
+// per attachment + glDrawBuffers + glDeleteFramebuffers for every render pass, and skips the
+// glBindFramebuffer(GL_READ_FRAMEBUFFER, 0) before it (every other GL path binds its own read
+// framebuffer). A texture's GL name can be reused once deleted, so Texture and TextureView drop
+// every cached framebuffer that holds their name right before glDeleteTextures. Everything runs on
+// the GL thread (Queue::Submit and the deferred destroys, under the device lock); one device and
+// one context, as on the Switch.
+
+#ifndef SRC_DAWN_NATIVE_OPENGL_SWITCHFBOCACHEGL_H_
+#define SRC_DAWN_NATIVE_OPENGL_SWITCHFBOCACHEGL_H_
+
+#if defined(__SWITCH__)
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#include "src/dawn/common/Constants.h"
+#include "src/dawn/native/opengl/OpenGLFunctions.h"
+
+namespace dawn::native::opengl::switch_fbo_cache {
+
+struct Attachment {
+    GLenum point;    // GL_COLOR_ATTACHMENTi, GL_DEPTH_ATTACHMENT, ...
+    GLuint texture;  // GL texture name
+    GLenum target;   // texture target (FramebufferTextureHelper's textarget)
+    GLuint level;
+    GLuint layer;
+
+    bool operator==(const Attachment& o) const {
+        return point == o.point && texture == o.texture && target == o.target &&
+               level == o.level && layer == o.layer;
+    }
+};
+
+struct Key {
+    std::array<Attachment, kMaxColorAttachments + 1> attachments{};
+    uint32_t count = 0;
+
+    void Add(const Attachment& a) { attachments[count++] = a; }
+    bool operator==(const Key& o) const {
+        if (count != o.count) {
+            return false;
+        }
+        for (uint32_t i = 0; i < count; ++i) {
+            if (!(attachments[i] == o.attachments[i])) {
+                return false;
+            }
+        }
+        return true;
+    }
+    bool Holds(GLuint texture) const {
+        for (uint32_t i = 0; i < count; ++i) {
+            if (attachments[i].texture == texture) {
+                return true;
+            }
+        }
+        return false;
+    }
+};
+
+struct Entry {
+    Key key;
+    GLuint fbo;
+};
+
+// Aurora's frame uses a dozen distinct attachment sets (EFB, copy-conversion targets, offscreen
+// and snapshot pools, present, ImGui); past this many the cache is emptied and refilled.
+inline constexpr size_t kMaxEntries = 64;
+
+inline int gEnabled = -1;
+inline std::vector<Entry> gEntries;
+inline uint64_t gHits = 0;
+inline uint64_t gMisses = 0;
+
+inline bool Enabled() {
+    if (gEnabled < 0) {
+        const char* v = std::getenv("COS_SWITCH_GL_FBO_CACHE");
+        gEnabled = v != nullptr && std::strcmp(v, "1") == 0 ? 1 : 0;
+        if (gEnabled) {
+            std::fprintf(stderr,
+                         "[dawn] COS_SWITCH_GL_FBO_CACHE: render pass framebuffers cached by "
+                         "attachments\n");
+        }
+    }
+    return gEnabled == 1;
+}
+
+inline GLuint Find(const Key& key) {
+    for (const Entry& e : gEntries) {
+        if (e.key == key) {
+            ++gHits;
+            return e.fbo;
+        }
+    }
+    ++gMisses;
+    return 0;
+}
+
+inline void Insert(const OpenGLFunctions& gl, const Key& key, GLuint fbo) {
+    if (gEntries.size() >= kMaxEntries) {
+        for (const Entry& e : gEntries) {
+            gl.DeleteFramebuffers(1, &e.fbo);
+        }
+        gEntries.clear();
+        std::fprintf(stderr, "[dawn] COS_SWITCH_GL_FBO_CACHE: %zu framebuffers, emptied (%llu hits, "
+                             "%llu misses)\n",
+                     kMaxEntries, static_cast<unsigned long long>(gHits),
+                     static_cast<unsigned long long>(gMisses));
+    }
+    gEntries.push_back({key, fbo});
+}
+
+// Before glDeleteTextures(texture): drop the framebuffers that hold it.
+inline void Forget(const OpenGLFunctions& gl, GLuint texture) {
+    if (gEntries.empty()) {
+        return;
+    }
+    for (size_t i = 0; i < gEntries.size();) {
+        if (gEntries[i].key.Holds(texture)) {
+            gl.DeleteFramebuffers(1, &gEntries[i].fbo);
+            gEntries[i] = gEntries.back();
+            gEntries.pop_back();
+        } else {
+            ++i;
+        }
+    }
+}
+
+}  // namespace dawn::native::opengl::switch_fbo_cache
+
+#endif  // defined(__SWITCH__)
+
+#endif  // SRC_DAWN_NATIVE_OPENGL_SWITCHFBOCACHEGL_H_
