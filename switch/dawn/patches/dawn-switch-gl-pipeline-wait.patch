Switch: per-thread render pipeline build times, with the wait for the GL context apart

dawn-switch-gl-pipeline-compile.patch counts a build's Tint translation and its time "holding the
GL context", but that second part starts before ExecutePipelineGL has the context: when the render
worker holds it (its first frame holds it for ~300 ms), a pipeline the shader cache has in full
still takes 70-130 ms on the compile thread. Aurora's warm-up read that as a cache miss and brought
up the boot loading screen on warm boots.

Now the calling thread's builds keep three running totals - translation, waiting for the context,
holding it - read with dawn_switch_gl_thread_pipeline_ns (Aurora's compile thread, around each
pipeline it builds; switch/native/aurora/patches/0012).

--- a/src/dawn/native/opengl/RenderPipelineGL.cpp
+++ b/src/dawn/native/opengl/RenderPipelineGL.cpp
@@ -35,6 +35,25 @@
 #include "src/dawn/native/opengl/SwitchStatsGL.h"
 #include "src/dawn/native/opengl/UtilsGL.h"
 
+#if defined(__SWITCH__)
+namespace {
+// The calling thread's render pipeline builds so far (dawn-switch-gl-pipeline-wait.patch): ns in
+// the Tint translation, ns waiting for the GL context (another thread, normally the render
+// worker, had it) and ns holding it (Mesa's compile and link). Aurora's compile thread reads them
+// around each pipeline it builds to tell a shader cache miss from a build that only waited.
+thread_local uint64_t tSwitchPipelineTranslateNs = 0;
+thread_local uint64_t tSwitchPipelineWaitNs = 0;
+thread_local uint64_t tSwitchPipelineHeldNs = 0;
+thread_local uint64_t tSwitchPipelineLockedAt = 0;
+}  // namespace
+
+extern "C" void dawn_switch_gl_thread_pipeline_ns(uint64_t out[3]) {
+    out[0] = tSwitchPipelineTranslateNs;
+    out[1] = tSwitchPipelineWaitNs;
+    out[2] = tSwitchPipelineHeldNs;
+}
+#endif
+
 namespace dawn::native::opengl {
 
 namespace {
@@ -258,9 +277,14 @@
                                     bgraSwizzleAttributes));
     }
     const uint64_t switchContextStart = ss::NowNs();
+    tSwitchPipelineLockedAt = 0;
 #endif
     DAWN_TRY(device->ExecutePipelineGL(
         [self = Ref<RenderPipeline>(this)](const OpenGLFunctions& gl) -> MaybeError {
+#if defined(__SWITCH__)
+            // The GL context is ours from here (ExecutePipelineGL runs this on this thread).
+            tSwitchPipelineLockedAt = switch_stats::NowNs();
+#endif
             VertexAttributeMask bgraSwizzleAttributes = {};
             for (VertexAttributeLocation i : self->GetAttributeLocationsUsed()) {
                 bgraSwizzleAttributes.set(
@@ -278,6 +302,13 @@
                                                     std::memory_order_relaxed);
     ss::gTotals[ss::kPipelineContextNs].fetch_add(switchEnd - switchContextStart,
                                                   std::memory_order_relaxed);
+    {
+        const uint64_t lockedAt =
+            tSwitchPipelineLockedAt != 0 ? tSwitchPipelineLockedAt : switchContextStart;
+        tSwitchPipelineTranslateNs += switchContextStart - switchTranslateStart;
+        tSwitchPipelineWaitNs += lockedAt - switchContextStart;
+        tSwitchPipelineHeldNs += switchEnd - lockedAt;
+    }
 #endif
 
