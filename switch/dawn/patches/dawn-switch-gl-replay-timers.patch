+        ::dawn::native::opengl::switch_stats::counter)
+// `call` is a DAWN_GL_TRY statement; the enclosing function returns MaybeError.
+#define DAWN_SWITCH_DRAW(call)                                                            \
+    DAWN_TRY(::dawn::native::opengl::switch_stats::TimedDraw([&]() -> ::dawn::native::MaybeError { \
+        call;                                                                             \
