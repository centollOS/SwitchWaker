+    // Where a render pass's replay time goes (ticks of the system counter while counting,
+    // reported in ns by dawn_switch_gl_cmd_stats). Mesa does most of its state validation
+    // inside the draw call, so kDrawCallTicks also carries the cost of the state set before it;
+    // the draws right after a pipeline change or a texture bind are timed apart to show that.
+    kPipelineTicks,          // SetRenderPipeline (glUseProgram, VAO, fixed-function state)
+    kBindGroupTicks,         // applying bind groups before a draw (UBO/SSBO ranges, textures)
+    kImmediatesTicks,        // glUniform of immediates before a draw
+    kVertexStateTicks,       // vertex/index buffer state and primitive restart before a draw
+    kDrawCallTicks,          // the glDraw* calls themselves
