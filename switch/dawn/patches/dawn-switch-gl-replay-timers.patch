+    kVertexArrayBinds,       // glBindVertexArray when applying a pipeline
+    kIndexBufferBinds,       // glBindBuffer(GL_ELEMENT_ARRAY_BUFFER) before a draw
     kCount
 };
 
+// Counters holding system counter ticks (19.2 MHz) rather than ns or counts.
+inline bool IsTicks(int counter) {
+    return counter == kPipelineTicks || counter == kBindGroupTicks || counter == kImmediatesTicks ||
+           counter == kVertexStateTicks || counter == kDrawCallTicks ||
+           counter == kDrawAfterPipelineTicks || counter == kDrawAfterTexturesTicks;
+}
+
 inline uint64_t gLocal[kCount];
+// Set by a pipeline change / a sampled-texture bind, cleared by the next draw.
+inline bool gPendingPipeline = false;
+inline bool gPendingTextures = false;
 inline std::atomic<uint64_t> gTotals[kCount];
 
 inline void Add(Counter counter, uint64_t n = 1) {
@@ -56,13 +82,70 @@ inline uint64_t NowNs() {
                                      .count());
 }
 
+// The system counter, as libnx's armGetSystemTick reads it: a few ns per read.
+inline uint64_t Ticks() {
+    uint64_t t;
+    asm volatile("mrs %0, cntpct_el0" : "=r"(t));
+    return t;
+}
+
+inline uint64_t TicksToNs(uint64_t ticks) {
+    return ticks * 625 / 12;  // 19.2 MHz
+}
+
+// Adds the ticks from construction to destruction to a counter.
+class TickScope {
+  public:
+    explicit TickScope(Counter counter) : mCounter(counter), mStart(Ticks()) {}
+    ~TickScope() { Add(mCounter, Ticks() - mStart); }
+    TickScope(const TickScope&) = delete;
+    TickScope& operator=(const TickScope&) = delete;
+
+  private:
+    Counter mCounter;
+    uint64_t mStart;
+};
+
+// Times one glDraw* call and files it under the draws after a pipeline change or a texture
+// bind when it is one.
+template <typename F>
+inline auto TimedDraw(F&& draw) {
+    const uint64_t start = Ticks();
+    auto result = draw();
+    const uint64_t ticks = Ticks() - start;
+    Add(kDrawCallTicks, ticks);
+    if (gPendingPipeline) {
+        Add(kDrawsAfterPipeline, 1);
+        Add(kDrawAfterPipelineTicks, ticks);
+    } else if (gPendingTextures) {
+        Add(kDrawsAfterTextures, 1);
+        Add(kDrawAfterTexturesTicks, ticks);
+    }
+    gPendingPipeline = false;
+    gPendingTextures = false;
+    return result;
+}
