+#if defined(__SWITCH__)
+// Switch (switch/dawn/patches/dawn-switch-gl-program-share.patch): pipelines whose stages translate
+// to the same GLSL share one linked GL program. Mesa 20.1 on Horizon has no program binaries
+// (GL_NUM_PROGRAM_BINARY_FORMATS is 0: its disk shader cache is compiled out there), so every
+// program is compiled and linked from source, 0.1-0.4 s each on the one GL context, and Aurora's
+// GX pipelines that differ only in blend, depth, cull or polygon offset state translate to the same
+// GLSL. The key is the program binary cache key above (device, stages and their GLSL), hashed twice;
+// what the program carries besides its code (sampler uniforms, the immediates location) follows
+// from that GLSL, so a pipeline that takes a linked program sets the same values again. The cache
+// owns the programs: pipelines do not delete a shared program (mProgram is 0 after
+// InitializeBase), the context's destruction does. Programs of a previous device's context are
+// forgotten when a pipeline of a new context first looks one up.
+struct SharedProgramKey {
+    uint64_t hashA;
+    uint64_t hashB;
+    size_t size;
+
+    bool operator==(const SharedProgramKey& other) const {
+        return hashA == other.hashA && hashB == other.hashB && size == other.size;
+    }
+    template <typename H>
+    friend H AbslHashValue(H h, const SharedProgramKey& key) {
+        return H::combine(std::move(h), key.hashA, key.hashB, key.size);
+    }
+};
+
+struct SharedProgramCache {
+    std::mutex mutex;
+    EGLContext context = EGL_NO_CONTEXT;
+    absl::flat_hash_map<SharedProgramKey, GLuint> programs;
+    uint64_t linked = 0;  // programs compiled and linked (or loaded) by a pipeline
+    uint64_t shared = 0;  // pipelines that took an already linked program
+};
+
+SharedProgramCache& GetSharedProgramCache() {
+    static SharedProgramCache* cache = new SharedProgramCache;
+    return *cache;
+}
+
+SharedProgramKey MakeSharedProgramKey(const CacheKey& key) {
+    const std::string_view bytes(reinterpret_cast<const char*>(key.data()), key.size());
+    return {.hashA = static_cast<uint64_t>(absl::HashOf(bytes)),
+            .hashB = static_cast<uint64_t>(std::hash<std::string_view>{}(bytes)),
+            .size = key.size()};
+}
+
+EGLContext SharedProgramContext(DeviceBase* device) {
+    return ToBackend(device)->GetContext()->GetRawContext();
+}
+
+GLuint FindSharedProgram(DeviceBase* device, const SharedProgramKey& key) {
+    SharedProgramCache& cache = GetSharedProgramCache();
+    const EGLContext context = SharedProgramContext(device);
+    std::lock_guard<std::mutex> lock(cache.mutex);
+    if (cache.context != context) {
+        cache.programs.clear();
+        cache.context = context;
+    }
+    auto it = cache.programs.find(key);
+    if (it == cache.programs.end()) {
+        return 0;
+    }
+    cache.shared++;
+    return it->second;
+}
+
+void AddSharedProgram(DeviceBase* device, const SharedProgramKey& key, GLuint program) {
+    SharedProgramCache& cache = GetSharedProgramCache();
+    const EGLContext context = SharedProgramContext(device);
+    std::lock_guard<std::mutex> lock(cache.mutex);
+    if (cache.context != context) {
+        cache.programs.clear();
+        cache.context = context;
+    }
+    cache.programs.emplace(key, program);
+    cache.linked++;
+}
+#endif
+
 }  // anonymous namespace
 
+#if defined(__SWITCH__)
+// Running totals of the shared program cache, for the native port's precompile and perf lines.
+extern "C" void dawn_switch_gl_program_stats(uint64_t* linked, uint64_t* shared) {
+    SharedProgramCache& cache = GetSharedProgramCache();
+    std::lock_guard<std::mutex> lock(cache.mutex);
+    if (linked != nullptr) {
+        *linked = cache.linked;
+    }
+    if (shared != nullptr) {
+        *shared = cache.shared;
+    }
+}
+#endif
