diff --git a/src/dawn/native/opengl/TextureGL.h b/src/dawn/native/opengl/TextureGL.h
index 3fd3604..0d43ef9 100644
--- a/src/dawn/native/opengl/TextureGL.h
+++ b/src/dawn/native/opengl/TextureGL.h
@@ -65,6 +65,16 @@ class Texture final : public TextureBase {
 
     MaybeError SynchronizeTextureBeforeUse();
 
+    // The sampling parameters CommandBufferGL last set on the GL texture object (-1: not set
+    // there yet), so that binding the texture again sets only those that change.
+    struct AppliedSamplingParams {
+        GLint baseLevel = -1;
+        GLint maxLevel = -1;
+        GLint depthStencilMode = -1;
+        GLint swizzle[4] = {-1, -1, -1, -1};
+    };
+    AppliedSamplingParams& GetAppliedSamplingParams() { return mAppliedSamplingParams; }
+
   private:
     ~Texture() override;
 
@@ -76,6 +86,7 @@ class Texture final : public TextureBase {
     GLuint mHandle;
     OwnsHandle mOwnsHandle = OwnsHandle::No;
     GLenum mTarget;
+    AppliedSamplingParams mAppliedSamplingParams;
 };
 
