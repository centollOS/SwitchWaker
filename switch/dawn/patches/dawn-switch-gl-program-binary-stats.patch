+// Switch (switch/dawn/patches/dawn-switch-gl-program-binary-stats.patch): what the program binary
+// cache did, for the native port's "[switch] shader" log lines (switch/native/source). The Switch
+// build of Mesa (switch/mesa) offers program binaries when its shader cache is on.
+struct ProgramBinaryStats {
+    std::atomic<uint64_t> formats{0};   // GL_NUM_PROGRAM_BINARY_FORMATS at the last query
+    std::atomic<uint64_t> hits{0};      // programs loaded from a cached binary
+    std::atomic<uint64_t> misses{0};    // no cached binary for the program
+    std::atomic<uint64_t> rejected{0};  // a cached binary the driver refused (stale or damaged)
+    std::atomic<uint64_t> stored{0};    // binaries stored after a link
+    std::atomic<uint64_t> storedBytes{0};
+};
+ProgramBinaryStats& GetProgramBinaryStats() {
+    static ProgramBinaryStats* stats = new ProgramBinaryStats;
+    return *stats;
+}
+#endif
