+
+// Running totals of the program binary cache: out[0] GL_NUM_PROGRAM_BINARY_FORMATS, then hits,
+// misses, rejected binaries, binaries stored and their bytes. Returns the number of values (6).
+extern "C" int dawn_switch_gl_program_binary_stats(uint64_t* out, int count) {
+    ProgramBinaryStats& stats = GetProgramBinaryStats();
+    const uint64_t values[6] = {stats.formats.load(), stats.hits.load(),     stats.misses.load(),
+                                stats.rejected.load(), stats.stored.load(), stats.storedBytes.load()};
+    for (int i = 0; i < count && i < 6; i++) {
+        out[i] = values[i];
+    }
+    return 6;
+}
 #endif
 
