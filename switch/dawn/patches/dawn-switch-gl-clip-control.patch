@@ -0,0 +1,49 @@
+// Switch (the game native port, bug B7): depth clipping in WebGPU's [0, w] range.
+//
+// Dawn's GL backend kept GL's default [-w, w] clip range for z and had Tint rewrite every vertex
+// shader's gl_Position.z as 2 * z - w. With Aurora's reversed Z and a near plane of 1, z is about
+// 1 while w is the distance (thousands of units), so the subtraction rounds z to about 2^-24 of w:
+// the depth buffer then resolves no better than a 24-bit one, with rounding noise that changes as
+// the camera moves. Decals a unit above another surface (Outset's shore foam) lost the depth test
+// in patches that flickered. With glClipControl(GL_LOWER_LEFT, GL_ZERO_TO_ONE) (GL 4.5,
+// GL_ARB_clip_control, GLES GL_EXT_clip_control; Mesa exposes it on nouveau) z is clipped and
+// mapped as WebGPU specifies and the shaders keep it unchanged (Tint option depth_zero_to_one):
+// the same depth values as before, at full float precision, as on Metal, Vulkan and D3D.
+//
+// COS_SWITCH_GL_CLIP_CONTROL=0 at run time keeps the old remap (for A/B runs). Without the entry
+// point, or if the call fails, the old remap is used as well. One "[dawn]" line logs the choice.
+#ifndef SRC_DAWN_NATIVE_OPENGL_SWITCHCLIPCONTROLGL_H_
+#define SRC_DAWN_NATIVE_OPENGL_SWITCHCLIPCONTROLGL_H_
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#ifndef GL_LOWER_LEFT
+#define GL_LOWER_LEFT 0x8CA1
+#endif
+#ifndef GL_ZERO_TO_ONE
+#define GL_ZERO_TO_ONE 0x935F
+#endif
+
+namespace dawn::native::opengl::switch_clip_control {
+
+inline bool Enabled() {
+    static const bool enabled = [] {
+        const char* v = std::getenv("COS_SWITCH_GL_CLIP_CONTROL");
+        return v == nullptr || v[0] == '\0' || std::strcmp(v, "0") != 0;
+    }();
+    return enabled;
+}
+
+inline void Log(bool zeroToOne, bool available) {
+    std::fprintf(stderr, "[dawn] COS_SWITCH_GL_CLIP_CONTROL: %s\n",
+                 zeroToOne    ? "z clipped to [0, w] (glClipControl ZERO_TO_ONE), no 2z - w remap"
+                 : !Enabled() ? "off (2z - w remap)"
+                 : available  ? "glClipControl failed, 2z - w remap"
+                              : "no glClipControl in this context, 2z - w remap");
+}
+
+}  // namespace dawn::native::opengl::switch_clip_control
+
+#endif  // SRC_DAWN_NATIVE_OPENGL_SWITCHCLIPCONTROLGL_H_
