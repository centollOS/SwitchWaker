 MaybeError RenderPipeline::CreateVAOForVertexState(const OpenGLFunctions& gl) {
+#if defined(__SWITCH__)
+    // A pipeline without vertex attributes (all of Aurora's GX pipelines pull their vertices
+    // from storage buffers) has a VAO in the default state but for the element array buffer,
+    // which the render pass binds before drawing. Such pipelines share one VAO, so that a
+    // pipeline change does not switch VAOs: on Mesa 20.1 that makes the next draw revalidate
+    // the vertex arrays and Dawn rebind the index buffer. The Switch build has one device and
+    // all GL work runs on its one context (gl_defer), so the shared VAO is a plain static that
+    // is never deleted.
+    if (!GetAttributeLocationsUsed().any()) {
+        static GLuint sSharedVertexArrayObject = 0;
+        if (sSharedVertexArrayObject == 0) {
+            DAWN_GL_TRY(gl, GenVertexArrays(1, &sSharedVertexArrayObject));
+        }
+        mVertexArrayObject = sSharedVertexArrayObject;
+        mSharesVertexArrayObject = true;
+        return {};
+    }
+#endif
     DAWN_GL_TRY(gl, GenVertexArrays(1, &mVertexArrayObject));
     DAWN_GL_TRY(gl, BindVertexArray(mVertexArrayObject));
 
