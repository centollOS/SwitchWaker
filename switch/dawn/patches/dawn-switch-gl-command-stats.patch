diff --git a/src/dawn/native/opengl/SwitchStatsGL.h b/src/dawn/native/opengl/SwitchStatsGL.h
new file mode 100644
index 0000000..0e16252
--- /dev/null
+++ b/src/dawn/native/opengl/SwitchStatsGL.h
@@ -0,0 +1,68 @@
+// Switch only (switch/dawn/patches): what the GL backend's replay of a submission costs, for the
+// native port's "[cos] perf-switch" lines (switch/native/source). All GL work of a frame runs
+// under the device lock inside Queue::Submit (gl_defer), so the per-call counters are plain
+// integers only that thread touches; Publish adds them to the running totals the harness reads
+// (dawn_switch_gl_cmd_stats, CommandBufferGL.cpp) once per Execute and per flush.
+
+#ifndef SRC_DAWN_NATIVE_OPENGL_SWITCHSTATSGL_H_
+#define SRC_DAWN_NATIVE_OPENGL_SWITCHSTATSGL_H_
+
+#if defined(__SWITCH__)
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace dawn::native::opengl::switch_stats {
+
+enum Counter : int {
+    kRenderPasses,      // ExecuteRenderPass
+    kDraws,             // Draw, DrawIndexed and the indirect draws
+    kPipelineApplies,   // SetRenderPipeline (glUseProgram and the pipeline's fixed state)
+    kBindGroupApplies,  // ApplyBindGroup
+    kTextureBinds,      // glBindTexture of a sampled texture, per texture unit
+    kTexParams,         // glTexParameteri issued while binding sampled textures
+    kTexParamsSkipped,  // ... and left out because the texture already had the value
+    kUniformUploads,    // glUniform1uiv of immediates
+    kBufferCopies,      // CopyBufferToBuffer (glCopyBufferSubData)
+    kBufferCopyBytes,
+    kTextureUploads,    // CopyBufferToTexture
+    kExecuteNs,         // CommandBuffer::Execute
+    kFlushNs,           // Device::FlushPendingGLCommands, Execute and context release included
+    kFlushItems,        // deferred GL work items run by it (one of them is the Execute)
+    kReleaseNs,         // the context release (eglMakeCurrent) at the end of a flush
+    kCount
+};
+
+inline uint64_t gLocal[kCount];
+inline std::atomic<uint64_t> gTotals[kCount];
+
+inline void Add(Counter counter, uint64_t n = 1) {
+    gLocal[counter] += n;
+}
+
+inline void Publish() {
+    for (int i = 0; i < kCount; ++i) {
+        if (gLocal[i] != 0) {
+            gTotals[i].fetch_add(gLocal[i], std::memory_order_relaxed);
+            gLocal[i] = 0;
+        }
+    }
+}
+
+inline uint64_t NowNs() {
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                     std::chrono::steady_clock::now().time_since_epoch())
+                                     .count());
+}
+
+}  // namespace dawn::native::opengl::switch_stats
+
+#define DAWN_SWITCH_STAT(counter, n) \
+    ::dawn::native::opengl::switch_stats::Add(::dawn::native::opengl::switch_stats::counter, (n))
+
+#else
+#define DAWN_SWITCH_STAT(counter, n) ((void)0)
+#endif
+
+#endif  // SRC_DAWN_NATIVE_OPENGL_SWITCHSTATSGL_H_
