diff --git a/src/tint/utils/text_generator/text_generator.cc b/src/tint/utils/text_generator/text_generator.cc
--- a/src/tint/utils/text_generator/text_generator.cc
+++ b/src/tint/utils/text_generator/text_generator.cc
