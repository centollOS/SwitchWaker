+// Switch (COS_SWITCH_GL_STATE_CACHE): ApplyNow with every call skipped whose value the pass's
+// cache says GL already has (PersistentPipelineState::AppliedState).
+MaybeError RenderPipeline::ApplyNowCached(const OpenGLFunctions& gl,
+                                          PersistentPipelineState& persistentPipelineState) {
+    PersistentPipelineState::AppliedState& c = persistentPipelineState.Applied();
+    const bool all = !c.valid;
+    c.valid = true;
+    DAWN_TRY(PipelineGL::ApplyNow(gl, ToBackend(GetLayout()), &c.program));
+
+    DAWN_ASSERT(mVertexArrayObject);
+    if (persistentPipelineState.GetBoundVertexArray() != mVertexArrayObject) {
+        DAWN_GL_TRY(gl, BindVertexArray(mVertexArrayObject));
+        persistentPipelineState.SetBoundVertexArray(mVertexArrayObject);
+        DAWN_SWITCH_STAT(kVertexArrayBinds, 1);
+    }
+
+    auto enable = [&](GLenum cap, bool on, bool& cached) -> MaybeError {
+        if (all || cached != on) {
+            if (on) {
+                DAWN_GL_TRY(gl, Enable(cap));
+            } else {
+                DAWN_GL_TRY(gl, Disable(cap));
+            }
+            cached = on;
+        }
+        return {};
+    };
+
+    // Front face and culling (inverted winding: see ApplyFrontFaceAndCulling).
+    const GLenum frontFace = (GetFrontFace() == wgpu::FrontFace::CCW) ? GL_CW : GL_CCW;
+    if (all || c.frontFace != frontFace) {
+        DAWN_GL_TRY(gl, FrontFace(frontFace));
+        c.frontFace = frontFace;
+    }
+    const wgpu::CullMode cullMode = GetCullMode();
+    DAWN_TRY(enable(GL_CULL_FACE, cullMode != wgpu::CullMode::None, c.cull));
+    if (cullMode != wgpu::CullMode::None) {
+        const GLenum cullFace = (cullMode == wgpu::CullMode::Front) ? GL_FRONT : GL_BACK;
+        if (all || c.cullFace != cullFace) {
+            DAWN_GL_TRY(gl, CullFace(cullFace));
+            c.cullFace = cullFace;
+        }
+    }
+
+    // Depth and stencil (as ApplyDepthStencilState).
+    const DepthStencilState* ds = GetDepthStencilState();
+    DAWN_TRY(enable(GL_DEPTH_TEST,
+                    !(ds->depthCompare == wgpu::CompareFunction::Always &&
+                      ds->depthWriteEnabled != wgpu::OptionalBool::True),
+                    c.depthTest));
+    const bool depthMask = ds->depthWriteEnabled == wgpu::OptionalBool::True;
+    if (all || c.depthMask != depthMask) {
+        DAWN_GL_TRY(gl, DepthMask(depthMask ? GL_TRUE : GL_FALSE));
+        c.depthMask = depthMask;
+    }
+    const GLenum depthFunc = ToOpenGLCompareFunction(ds->depthCompare);
+    if (all || c.depthFunc != depthFunc) {
+        DAWN_GL_TRY(gl, DepthFunc(depthFunc));
+        c.depthFunc = depthFunc;
+    }
+    DAWN_TRY(enable(GL_STENCIL_TEST, UsesStencil(), c.stencilTest));
+    DAWN_TRY(persistentPipelineState.SetStencilFuncsAndMask(
+        gl, ToOpenGLCompareFunction(ds->stencilBack.compare),
+        ToOpenGLCompareFunction(ds->stencilFront.compare), ds->stencilReadMask));
+    const std::array<GLenum, 6> stencilOps = {
+        OpenGLStencilOperation(ds->stencilBack.failOp),
+        OpenGLStencilOperation(ds->stencilBack.depthFailOp),
+        OpenGLStencilOperation(ds->stencilBack.passOp),
+        OpenGLStencilOperation(ds->stencilFront.failOp),
+        OpenGLStencilOperation(ds->stencilFront.depthFailOp),
+        OpenGLStencilOperation(ds->stencilFront.passOp)};
+    if (all || c.stencilOps != stencilOps) {
+        DAWN_GL_TRY(gl, StencilOpSeparate(GL_BACK, stencilOps[0], stencilOps[1], stencilOps[2]));
+        DAWN_GL_TRY(gl, StencilOpSeparate(GL_FRONT, stencilOps[3], stencilOps[4], stencilOps[5]));
+        c.stencilOps = stencilOps;
+    }
+    if (all || c.stencilWriteMask != ds->stencilWriteMask) {
+        DAWN_GL_TRY(gl, StencilMask(ds->stencilWriteMask));
+        c.stencilWriteMask = ds->stencilWriteMask;
+    }
+
+    if (all || c.sampleMask != GetSampleMask()) {
+        DAWN_GL_TRY(gl, SampleMaski(0, GetSampleMask()));
+        c.sampleMask = GetSampleMask();
+    }
+    DAWN_TRY(enable(GL_SAMPLE_ALPHA_TO_COVERAGE, IsAlphaToCoverageEnabled(), c.alphaToCoverage));
+
+    DAWN_TRY(enable(GL_POLYGON_OFFSET_FILL, IsDepthBiasEnabled(), c.polygonOffset));
+    if (IsDepthBiasEnabled()) {
+        float depthBias = GetDepthBias();
+        if (GetDevice()->IsToggleEnabled(Toggle::GLDepthBiasModifier)) {
+            depthBias *= 0.5f;  // as in ApplyNow
+        }
+        const float slopeScale = GetDepthBiasSlopeScale();
+        const float clamp = GetDepthBiasClamp();
+        if (all || c.slopeScale != slopeScale || c.depthBias != depthBias ||
+            c.depthBiasClamp != clamp) {
+            if (gl.PolygonOffsetClamp != nullptr) {
+                DAWN_GL_TRY(gl, PolygonOffsetClamp(slopeScale, depthBias, clamp));
+            } else {
+                DAWN_GL_TRY(gl, PolygonOffset(slopeScale, depthBias));
+            }
+            c.slopeScale = slopeScale;
+            c.depthBias = depthBias;
+            c.depthBiasClamp = clamp;
+        }
+    }
+
+    // Color targets (as ApplyColorState, indexed).
+    for (auto attachmentSlot : GetColorAttachmentsMask()) {
+        const ColorTargetState* state = GetColorTargetState(attachmentSlot);
+        const GLuint buffer = static_cast<GLuint>(static_cast<uint8_t>(attachmentSlot));
+        PersistentPipelineState::AppliedColorState& cc = c.color[buffer];
+        const bool known = !all && cc.known;
+        cc.known = true;
+        const bool blend = state->blend != nullptr;
+        if (!known || cc.blend != blend) {
+            if (blend) {
+                DAWN_GL_TRY(gl, Enablei(GL_BLEND, buffer));
+            } else {
+                DAWN_GL_TRY(gl, Disablei(GL_BLEND, buffer));
+            }
+            cc.blend = blend;
+        }
+        if (blend) {
+            const GLenum eqColor = GLBlendMode(state->blend->color.operation);
+            const GLenum eqAlpha = GLBlendMode(state->blend->alpha.operation);
+            if (!known || cc.equationColor != eqColor || cc.equationAlpha != eqAlpha) {
+                DAWN_GL_TRY(gl, BlendEquationSeparatei(buffer, eqColor, eqAlpha));
+                cc.equationColor = eqColor;
+                cc.equationAlpha = eqAlpha;
+            }
+            const GLenum srcColor = GLBlendFactor(state->blend->color.srcFactor, false);
+            const GLenum dstColor = GLBlendFactor(state->blend->color.dstFactor, false);
+            const GLenum srcAlpha = GLBlendFactor(state->blend->alpha.srcFactor, true);
+            const GLenum dstAlpha = GLBlendFactor(state->blend->alpha.dstFactor, true);
+            if (!known || cc.srcColor != srcColor || cc.dstColor != dstColor ||
+                cc.srcAlpha != srcAlpha || cc.dstAlpha != dstAlpha) {
+                DAWN_GL_TRY(gl, BlendFuncSeparatei(buffer, srcColor, dstColor, srcAlpha, dstAlpha));
+                cc.srcColor = srcColor;
+                cc.dstColor = dstColor;
+                cc.srcAlpha = srcAlpha;
+                cc.dstAlpha = dstAlpha;
+            }
+        }
+        const uint8_t mask = static_cast<uint8_t>(state->writeMask);
+        if (!known || cc.writeMask != mask) {
+            DAWN_GL_TRY(gl, ColorMaski(buffer, state->writeMask & wgpu::ColorWriteMask::Red,
+                                       state->writeMask & wgpu::ColorWriteMask::Green,
+                                       state->writeMask & wgpu::ColorWriteMask::Blue,
+                                       state->writeMask & wgpu::ColorWriteMask::Alpha));
+            cc.writeMask = mask;
+        }
+    }
+    return {};
+}
