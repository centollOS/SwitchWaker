--- a/src/dawn/native/opengl/SwitchGpuTimerGL.h
+++ b/src/dawn/native/opengl/SwitchGpuTimerGL.h
@@ -95,6 +95,20 @@
                 mState = 3;
             } else {
                 mState = gl.IsGLExtensionSupported("GL_EXT_disjoint_timer_query") ? 1 : 2;
+                // dawn-switch-gl-gpu-timer-scale.patch: the Tegra X1's PTIMER counts its 19.2 MHz
+                // clock as if it were the 31.25 MHz reference (Linux nvgpu scales its readings by
+                // 31.25/19.2 for that reason), so the elapsed "ns" nouveau reports are 1/1.6276 of
+                // the real time. On the console, frames that are GPU-bound take 1.63-1.65 times
+                // the raw GPU time (A_mori, draw-cost dip windows). COS_SWITCH_GPU_TIMER_SCALE
+                // overrides the factor (1 = raw).
+                mScale = 31250000.0 / 19200000.0;
+                if (const char* scale = std::getenv("COS_SWITCH_GPU_TIMER_SCALE");
+                    scale != nullptr && scale[0] != '\0') {
+                    const double value = std::strtod(scale, nullptr);
+                    if (value > 0.0) {
+                        mScale = value;
+                    }
+                }
             }
             gTotals[kGpuTimerState].store(mState, std::memory_order_relaxed);
         }
