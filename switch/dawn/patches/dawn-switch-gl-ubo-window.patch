--- /dev/null
+++ b/src/dawn/native/opengl/SwitchUniformWindowGL.h
@@ -0,0 +1,24 @@
+// Switch (switch/dawn/patches/dawn-switch-gl-ubo-window.patch): a dynamic-offset uniform buffer
+// read through a 64 KiB window.
+//
+// Aurora binds one uniform buffer at a new dynamic offset for almost every draw (each GX draw has
+// its own uniform record). In Dawn GL each such SetBindGroup is a glBindBufferRange, and in Mesa
+// 20.1 every UBO binding change makes the next draw re-validate the stage's constant buffers and
+// emit an nvc0 MEM_BARRIER (a shader cache invalidation on the GPU). With the window, the first
+// dynamic-offset uniform buffer binding of a pipeline layout is bound once for 64 KiB, the shader
+// reads it as array<vec4u, 4096> (Tint's UniformWindowOptions) and adds the record's position in
+// the window, an internal immediate uploaded with the other immediates (one glUniform1uiv the draw
+// does anyway), so the buffer is rebound only when a record falls outside the current window.
+#ifndef SRC_DAWN_NATIVE_OPENGL_SWITCHUNIFORMWINDOWGL_H_
+#define SRC_DAWN_NATIVE_OPENGL_SWITCHUNIFORMWINDOWGL_H_
+
+#include <cstdint>
+
+namespace dawn::native::opengl::switch_ubo_window {
+
+// The window: 64 KiB, the GL_MAX_UNIFORM_BLOCK_SIZE of Mesa's nvc0 and llvmpipe.
+inline constexpr uint32_t kWindowSize = 65536;
+
+}  // namespace dawn::native::opengl::switch_ubo_window
+
+#endif  // SRC_DAWN_NATIVE_OPENGL_SWITCHUNIFORMWINDOWGL_H_
