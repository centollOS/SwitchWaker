+/// Switch (SwitchUniformWindowGL.h in Dawn's GL backend): one uniform buffer binding read through a
+/// window. The buffer is bound once for a whole window of `window_size` bytes and the shader adds
+/// the record's position in that window, an internal immediate (in 16-byte units), to every load,
+/// so that a dynamic offset that moves within the window needs no new glBindBufferRange. The
+/// binding is decomposed to array<vec4u, window_size / 16>.
+struct UniformWindowOptions {
+    /// The binding point, in WGSL binding-point space (before remapping).
+    BindingPoint binding = {};
+    /// The byte offset of the u32 immediate holding the record's position in the window, in
+    /// 16-byte units.
+    uint32_t immediate_offset = 0;
+    /// The window's size in bytes (a multiple of 16).
+    uint32_t window_size = 65536;
+
+    /// Reflect the fields of this class so that it can be used by tint::ForeachField()
+    TINT_REFLECT(UniformWindowOptions, binding, immediate_offset, window_size);
+    TINT_REFLECT_HASH_CODE(UniformWindowOptions);
+};
