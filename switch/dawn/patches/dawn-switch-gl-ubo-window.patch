 namespace tint::glsl::writer {
 
+namespace {
+
+/// Switch (UniformWindowOptions): after DecomposeAccess has turned the uniform variable at
+/// `binding` into array<vec4u, N>, makes it array<vec4u, window_size / 16> and adds the internal
+/// immediate `immediate_index` of `immediates` to the index of every access to it.
+Result<SuccessType> UniformWindow(core::ir::Module& ir,
+                                  BindingPoint binding,
+                                  uint32_t window_size,
+                                  const core::ir::transform::ImmediateDataLayout& immediates,
+                                  uint32_t immediate_offset) {
+    using namespace tint::core::fluent_types;     // NOLINT
+    using namespace tint::core::number_suffixes;  // NOLINT
+    core::ir::Builder b{ir};
+    auto& ty = ir.Types();
+    for (auto* inst : *ir.root_block) {
+        auto* var = inst->As<core::ir::Var>();
+        if (!var || var->BindingPoint() != binding) {
+            continue;
+        }
+        auto* ptr_ty = var->Result()->Type()->As<core::type::Pointer>();
+        if (!ptr_ty || ptr_ty->AddressSpace() != core::AddressSpace::kUniform) {
+            continue;
+        }
+        auto* arr = ptr_ty->StoreType()->As<core::type::Array>();
+        if (!arr || !arr->ElemType()->Is<core::type::Vector>()) {
+            return Failure("uniform window: the uniform buffer was not decomposed");
+        }
+        for (auto& use : var->Result()->UsagesSorted()) {
+            auto* access = use.instruction->As<core::ir::Access>();
+            if (!access || use.operand_index != core::ir::Access::kObjectOperandOffset ||
+                access->Indices().empty()) {
+                return Failure("uniform window: unexpected use of the uniform buffer");
+            }
+            b.InsertBefore(access, [&] {
+                auto idx = u32(immediates.IndexOf(immediate_offset));
+                auto* base = b.Load(b.Access<ptr<immediate, u32>>(immediates.var, idx));
+                auto* index = b.InsertConvertIfNeeded(ty.u32(), access->Indices()[0]);
+                auto* sum = b.Add(index, base);
+                access->SetOperand(core::ir::Access::kIndicesOperandOffset, sum->Result());
+            });
+        }
+        const uint32_t count = window_size / arr->ElemType()->Size();
+        var->Result()->SetType(
+            ty.ptr(ptr_ty->AddressSpace(), ty.array(arr->ElemType(), count), ptr_ty->Access()));
+    }
+    return Success;
+}
+
