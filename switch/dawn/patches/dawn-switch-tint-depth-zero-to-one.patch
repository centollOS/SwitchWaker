diff --git a/src/tint/lang/glsl/writer/raise/shader_io.cc b/src/tint/lang/glsl/writer/raise/shader_io.cc
index 8778dc1..0ca99b0 100644
--- a/src/tint/lang/glsl/writer/raise/shader_io.cc
+++ b/src/tint/lang/glsl/writer/raise/shader_io.cc
@@ -275,11 +275,15 @@ struct StateImpl : core::ir::transform::ShaderIOBackendState {
             auto* y = builder.Swizzle(ty.f32(), value, {1});
             auto* new_y = builder.Negation(y);
 
-            // Recalculate gl_Position.z = ((2.0f * gl_Position.z) - gl_Position.w);
+            // Recalculate gl_Position.z = ((2.0f * gl_Position.z) - gl_Position.w), unless the
+            // target clips z to [0, w] like WebGPU (Switch: deko3d DepthZeroToOne).
             auto* z = builder.Swizzle(ty.f32(), value, {2});
