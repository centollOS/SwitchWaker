+    /// 2 * z - w (which rounds z to about 2^-24 of w).
+    bool depth_zero_to_one = false;
+
     /// Vertex inputs to perform BGRA swizzle on.
     std::unordered_set<uint32_t> bgra_swizzle_locations;
 
@@ -238,6 +243,7 @@ struct Options {
