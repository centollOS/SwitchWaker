+// Files the ticks the first render pass of an Execute added to the pass split under the
+// kFirstPass* counters: construct before the pass (lazy clears included), call Done after it.
+class FirstPassSnapshot {
+  public:
+    FirstPassSnapshot() {
+        for (int i = 0; i < kCount; ++i) {
+            mStart[i] = gLocal[i];
+        }
+    }
+    void Done() {
+        const auto delta = [&](Counter c) { return gLocal[c] - mStart[c]; };
+        Add(kFirstPasses, 1);
+        Add(kFirstPassTotalTicks, delta(kPassTotalTicks));
+        Add(kFirstPassLazyClearTicks, delta(kPassLazyClearTicks));
+        Add(kFirstPassFramebufferTicks, delta(kPassFramebufferTicks));
+        Add(kFirstPassDefaultStateTicks, delta(kPassDefaultStateTicks));
+        Add(kFirstPassClearTicks, delta(kPassClearTicks));
+        Add(kFirstPassEndTicks, delta(kPassEndTicks));
+        Add(kFirstPassReplayTicks, delta(kPipelineTicks) + delta(kBindGroupTicks) +
+                                       delta(kImmediatesTicks) + delta(kVertexStateTicks) +
+                                       delta(kDrawCallTicks) + delta(kPassDynamicStateTicks));
+    }
+
+  private:
+    uint64_t mStart[kCount];
+};
