         AddAttrib(EGL_CONTEXT_HARDENED_ANGLE, EGL_TRUE);
     }
 
+#if defined(__SWITCH__)
+    // COS_SWITCH_GL_NO_ERROR=1 (an A/B option of the native port): a KHR_no_error context, in
+    // which Mesa skips the error checks of every GL call (the draw and uniform validation
+    // included). A GL error then has undefined results instead of being recorded, so it is
+    // opt-in; without EGL_KHR_create_context_no_error, or if Mesa refuses the context, the
+    // ordinary context is made.
+    bool noErrorContext = false;
+    {
+        const char* noError = std::getenv("COS_SWITCH_GL_NO_ERROR");
+        const char* extensions = egl.QueryString(mDisplay->GetDisplay(), EGL_EXTENSIONS);
+        if (noError != nullptr && std::strcmp(noError, "1") == 0 && !useRobustness &&
+            extensions != nullptr &&
+            std::strstr(extensions, "EGL_KHR_create_context_no_error") != nullptr) {
+            AddAttrib(0x31B3 /* EGL_CONTEXT_OPENGL_NO_ERROR_KHR */, EGL_TRUE);
+            noErrorContext = true;
+        }
+    }
+#endif
+
     // The attrib list is finished with an EGL_NONE tag.
     attribs.push_back(EGL_NONE);
 
     mState.context =
         egl.CreateContext(mDisplay->GetDisplay(), contextConfig, sharedContext, attribs.data());
+#if defined(__SWITCH__)
+    if (noErrorContext) {
+        const bool refused = mState.context == EGL_NO_CONTEXT;
+        if (refused) {
+            attribs.pop_back();  // EGL_NONE
+            attribs.pop_back();  // EGL_TRUE
+            attribs.pop_back();  // EGL_CONTEXT_OPENGL_NO_ERROR_KHR
+            attribs.push_back(EGL_NONE);
+            mState.context = egl.CreateContext(mDisplay->GetDisplay(), contextConfig,
+                                               sharedContext, attribs.data());
+        }
+        std::fprintf(stderr, "[dawn] COS_SWITCH_GL_NO_ERROR: %s\n",
+                     refused ? "refused, ordinary GL context" : "KHR_no_error GL context");
+    }
+#endif
     DAWN_TRY(CheckEGL(egl, mState.context != EGL_NO_CONTEXT, "eglCreateContext"));
 
