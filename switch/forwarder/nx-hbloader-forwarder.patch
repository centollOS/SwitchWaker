+// Reads a short text file (trailing whitespace trimmed); false when missing or empty.
+static bool readSmallFile(const char* path, char* out, size_t size)
+{
+    int fd = open(path, O_RDONLY);
+    if (fd < 0)
+        return false;
+    ssize_t n = read(fd, out, size - 1);
+    close(fd);
+    if (n <= 0)
+        return false;
+    while (n > 0 && (out[n-1] == '\n' || out[n-1] == '\r' || out[n-1] == ' ' || out[n-1] == '\t'))
+        n--;
+    out[n] = '\0';
+    return n > 0;
+}
+
+static void loadForwarderTarget(void)
+{
+    bool ok = false;
+    if (R_SUCCEEDED(romfsInit())) {
+        ok = readSmallFile("romfs:/nextNroPath", g_nextNroPath, sizeof g_nextNroPath);
+        if (ok && !readSmallFile("romfs:/nextArgv", g_nextArgv, sizeof g_nextArgv))
+            strcpy(g_nextArgv, g_nextNroPath);
+        romfsExit();
+    }
+    if (!ok) {
+        memcpy(g_nextNroPath, FORWARDER_DEFAULT_NRO, sizeof(FORWARDER_DEFAULT_NRO));
+        memcpy(g_nextArgv,    FORWARDER_DEFAULT_NRO, sizeof(FORWARDER_DEFAULT_NRO));
+    }
+}
