+// Draw census (census.hpp): one CSV row per pass with its targets, load ops, draws and EFB copy.
+void census_pass_row(FramePacket& frame, const RenderPass& passInfo, const std::string& label) {
+  const auto& color = passInfo.colorAttachments[SceneColorAttachmentIndex];
+  uint32_t draws = 0;
+  for (const auto& c : passInfo.commands) {
+    draws += c.type == CommandType::Draw || c.type == CommandType::CustomDraw ? 1 : 0;
+  }
+  const wgpu::LoadOp colorLoad =
+      color.loadOp != wgpu::LoadOp::Undefined ? color.loadOp : (color.clear ? wgpu::LoadOp::Clear : wgpu::LoadOp::Load);
+  std::string resolve = "none";
+  std::string detail;
+  if (passInfo.resolveTarget) {
+    const auto& dst = passInfo.resolveTarget->size;
+    resolve = fmt::format("{}x{}", dst.width, dst.height);
+    detail = fmt::format("fmt {} src {}x{}+{}+{}{}", static_cast<int>(passInfo.resolveFormat),
+                         passInfo.resolveRect.width, passInfo.resolveRect.height, passInfo.resolveRect.x,
+                         passInfo.resolveRect.y, gx::is_depth_format(passInfo.resolveFormat) ? " depth" : "");
+  }
+  if (passInfo.snapshotColorDst || passInfo.snapshotDepthDst || passInfo.snapshotNormalDst) {
+    detail += " snapshot";
+  }
+  frame.census->passes.push_back(fmt::format("{},pass,{},{},{},{},{},{},{},{}", frame.census->passes.size(), label,
+                                             color.size.width, color.size.height, passInfo.colorAttachmentCount,
+                                             colorLoad == wgpu::LoadOp::Clear ? "clear" : "load", draws, resolve,
+                                             detail));
+}
+
 void render(wgpu::CommandEncoder& cmd, FramePacket& frame, RenderPass& passInfo, uint32_t passIndex) {
   ZoneScoped;
   if (!passInfo.sealed) {
@@ -242,8 +273,11 @@ void render(wgpu::CommandEncoder& cmd, FramePacket& frame, RenderPass& passInfo,
       .colorAttachmentCount = passInfo.colorAttachmentCount,
       .colorAttachments = attachments.data(),
       .depthStencilAttachment = depthStencilAttachmentPtr,
+      .occlusionQuerySet = frame.census ? frame.census->querySet : nullptr,
       .timestampWrites = webgpu::gpu_prof::pass_writes(label),
   };
+  if (frame.census)
+    UNLIKELY { census_pass_row(frame, passInfo, label); }
 
   auto pass = cmd.BeginRenderPass(&renderPassDescriptor);
   render_pass(pass, frame, passInfo);
@@ -412,6 +446,11 @@ void encode_op(wgpu::CommandEncoder& cmd, FramePacket& frame, const FrameOp& op)
     break;
   case FrameOpType::TextureCopy:
     if (op.textureCopy != nullptr) {
+      if (frame.census)
+        UNLIKELY {
+          frame.census->passes.push_back(fmt::format("{},copy,texture copy,{},{},0,,0,,", frame.census->passes.size(),
+                                                     op.textureCopy->size.width, op.textureCopy->size.height));
+        }
       const webgpu::gpu_prof::Zone zone{cmd, "Texture copy"};
       cmd.CopyTextureToTexture(&op.textureCopy->src, &op.textureCopy->dst, &op.textureCopy->size);
