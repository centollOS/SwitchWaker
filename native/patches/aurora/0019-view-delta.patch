+void AuroraSetViewDelta(const f32* delta, const f32* projFrom, const f32* projTo) {
+  GX_WRITE_AURORA(GX_AURORA_SET_VIEW_DELTA);
+  if (delta == nullptr || projFrom == nullptr || projTo == nullptr) {
+    GX_WRITE_U8(0);
+    return;
+  }
+  GX_WRITE_U8(1);
+  for (int i = 0; i < 12; ++i) {
+    GX_WRITE_F32(delta[i]);
+  }
+  for (int i = 0; i < 6; ++i) {
+    GX_WRITE_F32(projFrom[i]);
+  }
+  for (int i = 0; i < 6; ++i) {
+    GX_WRITE_F32(projTo[i]);
+  }
+}
