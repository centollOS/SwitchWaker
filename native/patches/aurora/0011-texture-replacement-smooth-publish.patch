+  std::vector<EntryLoadSnapshot> reloads;
+  {
+    std::lock_guard lk(s_registryMutex);
+    for (const auto& [key, cache] : s_cacheByKey) {
+      if (cache.tier != Tier::Full || !cache.handle) {
+        continue;
+      }
+      const auto* entry = find_selected_entry_locked(key);
+      if (entry == nullptr || entry->id != cache.id || entry->kind == EntryKind::Raw) {
+        continue;
+      }
+      const std::string pathString =
+          entry->kind == EntryKind::Virtual ? entry->virtualPath : io::fs_path_to_string(entry->path);
+      if (predicate(userData, pathString, cache.handle->size.width, cache.handle->size.height,
+                    cache.handle->mipCount)) {
