+
+void unregister_replacements_gradual(std::span<const ReplacementRegistration> registrations, bool rescan) {
+  std::vector<std::shared_ptr<VirtualReadState>> waitStates;
+  {
+    std::lock_guard lk(s_registryMutex);
+    for (const auto& registration : registrations) {
+      if (registration.id != 0) {
+        unregister_replacement_locked(registration, waitStates);
+      }
+    }
+  }
+  // A batch shares one read state: wait for each distinct one once.
+  std::sort(waitStates.begin(), waitStates.end());
+  waitStates.erase(std::unique(waitStates.begin(), waitStates.end()), waitStates.end());
+  wait_for_virtual_reads(waitStates);
+  if (rescan) {
+    gx::texture::request_rescan(true);
