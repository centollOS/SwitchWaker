+  for (size_t i = 0; i < paths.size(); ++i) {
+    const auto path = paths[i];
+    const size_t slash = path.rfind('/');
+    keys[i] = parse_replacement_filename(slash == std::string_view::npos ? path : path.substr(slash + 1));
+  }
+  const auto readState = std::make_shared<VirtualReadState>();
+  {
+    std::lock_guard lk(s_registryMutex);
+    for (size_t i = 0; i < paths.size(); ++i) {
+      if (!keys[i].has_value()) {
+        continue;
+      }
+      ReplacementKey replacementKey{*keys[i]};
+      registrations[i] = ReplacementRegistration{
+          .id = s_nextRegistrationId++,
+          .key = replacementKey,
+      };
+      auto& entries = s_entriesByKey[replacementKey];
+      entries.push_back({
+          .id = registrations[i].id,
+          .priority = options.priority,
+          .sequence = s_nextSequence++,
+          .kind = EntryKind::Virtual,
+          .virtualPath = std::string{paths[i]},
+          .source = source,
+          .virtualReadState = readState,
+      });
+      ++s_sourceEntryCount;
+      erase_cache_locked(replacementKey);
+    }
+  }
+  if (rescan) {
+    gx::texture::request_rescan(false);
+  }
