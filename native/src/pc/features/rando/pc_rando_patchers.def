// The randomizer's archive patchers (docs/RANDOMIZER_PLAN.md step R0.10; pc_rando_resources.h).
// One line per step: PC_RANDO_PATCHER(<init function>), where <init function> is an
// extern "C" void <name>(void) defined in that step's module; it registers the step's patchers with
// pc_rando_register_dzx_patcher / pc_rando_register_res_patcher. The game side
// (game_hooks/pc_rando_hooks_resources.cpp) calls every init once, in this order, before the first
// archive is dispatched; patchers then run in registration order. Append-only: each step adds its
// line; on a merge keep both sides.
PC_RANDO_PATCHER(pc_rando_place_dzx_init) // R2.1: the placement in stage.dzs / room.dzr (chests; pc_rando_place_dzx.h)
PC_RANDO_PATCHER(pc_rando_place_actr_init) // R2.2: field items, pots, stone heads (ACTR) and their tweaks
PC_RANDO_PATCHER(pc_rando_place_scob_init) // R2.3: SCOB item locations (salvage, Big Octo, Gunboat, dig spot) and the Needle Rock salvage flags
PC_RANDO_PATCHER(pc_rando_stages_a_init) // R3.15: stage tweaks A (game_hooks/pc_rando_hooks_stages_a.cpp)
PC_RANDO_PATCHER(pc_rando_tweak_stages_b_init) // R3.16: stage tweaks B (failsafe and boss-door spawns, panning cutscenes, FH warp, magic jars, hint sign)
PC_RANDO_PATCHER(pc_rando_posttext_patchers_init) // R3.21: builds the post-randomization texts at the first archive load when the activation came before the message archive (debug boot)
PC_RANDO_PATCHER(pc_rando_place_event_init) // R2.4: the 11 event item locations (event_list.dat change_event_item; pc_rando_place_event.h)
PC_RANDO_PATCHER(pc_rando_tweak_added_chests_init) // R2.10: the 4 added chests (Jabun, Medli, Master Sword, Mother Isle), their room edits and the ajav_uzu event
PC_RANDO_PATCHER(pc_rando_start_init) // R3.2: start_ship_at_outset + prevent_fire_mountain_lava_softlock (sea/Stage Ship ACTR; game_hooks/pc_rando_hooks_start.cpp)
PC_RANDO_PATCHER(pc_rando_tweak_zephos_init) // R3.19: shorten_zephos_event (sea TACT_HT) and shorten_auction_intro_event (Orichh AUCTION_START)
PC_RANDO_PATCHER(pc_rando_pirate_ship_init) // R3.17: add_pirate_ship_to_windfall (sea/Room11 ship, Asoko Aryll/SwOps/Ashut, EVNT and event AryllOpensDoor, messages 3008/849/850; game_hooks/pc_rando_hooks_pirate_ship.cpp)
PC_RANDO_PATCHER(pc_rando_tweak_totg_init) // R3.18: allow_nonlinear_servants_of_the_towers (Siren stage.dzs doors + EVNT, Room7 switches + 2 SwOps, the servants' events)
PC_RANDO_PATCHER(pc_rando_trap_init) // R6.5: trap chests (params 0x40, DEFAULT_TREASURE_TRAP per stage) and chest type matches contents (pc_rando_trap.h); after R2.1 and R2.10
PC_RANDO_PATCHER(pc_rando_charts_init) // R6.6: randomized charts, the salvage chart index in sea/Room1-49 (the CmapDat.bin half is the d_menu_fmap.cpp hunk; pc_rando_charts.h)
PC_RANDO_PATCHER(pc_rando_bossreq_hooks_init) // R6.9: required bosses (GanonL/Room0 DngSw, 2 SwOps, ALLdie 0x26, TagMsg 851, NBOX10; message 851; pc_rando_bossreq.h)
PC_RANDO_PATCHER(pc_rando_hints_hooks_init) // R5.3: hint placement (the Ho Ho rooms' Ah y_rot facing their hint; the hint texts once the font is loaded; game_hooks/pc_rando_hooks_hints.cpp); after R3.21 (KoRL 3443)
