// The randomizer's in-game smokes (docs/RANDOMIZER_PLAN.md, "Tests"), run as
//   native/tools/run.sh rando [--stage ...] --env COS_RANDO_SMOKE=<name>
// pc_rando_smokes.cpp includes this list as an X-macro: PC_RANDO_SMOKE(<name>, <function>), where
// <name> is the COS_RANDO_SMOKE value and <function> is pc::<function>(unsigned int frames),
// defined in that step's own smokes/pc_rando_smoke_<name>.cpp and called every game frame
// (pc_rando_smokes.h). Append-only: each step adds one line; on a merge keep both sides.
PC_RANDO_SMOKE(null, randoSmokeNull) // R0.1: the switch, the defaults and activation
PC_RANDO_SMOKE(items, randoSmokeItems) // R0.8: item dispatch overrides and item/shop table snapshots
PC_RANDO_SMOKE(dzx, randoSmokeDzx) // R0.10: the archive-load hook (Asoko chest: identity hash, edited item, grown copy)
PC_RANDO_SMOKE(msg, randoSmokeMsg) // R0.12: the message overlay (3906 text, new 849, d_msg)
PC_RANDO_SMOKE(swop, randoSmokeSwop) // R3.7: custom actors SwOp and DngSw
PC_RANDO_SMOKE(nonlinA, randoSmokeNonlinA) // R3.9: nonlinear A (make_game_nonlinear.asm items 1-11)
PC_RANDO_SMOKE(nonlinB, randoSmokeNonlinB) // R3.10: make_game_nonlinear.asm items 12-22
PC_RANDO_SMOKE(cutscenes, randoSmokeCutscenes) // R3.11: cutscene removal (pearls, letters, warps, item-get music)
PC_RANDO_SMOKE(bugfixes, randoSmokeBugfixes) // R3.12: vanilla bug fixes (Skull Hammer guard, arrow callback, Sam) and the ReDead switch
PC_RANDO_SMOKE(text, randoSmokeText) // R4.2: the text input (seed grid through the menu, permalink import)
PC_RANDO_SMOKE(modes, randoSmokeModes) // R6.15: the small modes (hero mode, music, compass, targeting, low-health beep)
PC_RANDO_SMOKE(slot, randoSmokeSlot) // R0.7: slot binding (record in mReserve, sidecar, new game / load / title hooks)
PC_RANDO_SMOKE(fielditems, randoSmokeFielditems) // R2.11: any item anywhere (field models, item-get demo as a field item and from a chest)
PC_RANDO_SMOKE(progressive, randoSmokeProgressive) // R3.3: progressive items (tiers, item funcs, no-ops, demo/shop/field items, message 278)
PC_RANDO_SMOKE(dkeys, randoSmokeDkeys) // R3.4: the 22 per-dungeon item IDs (keys, Big Keys, maps, compasses)
PC_RANDO_SMOKE(tingle, randoSmokeTingle) // R3.6: Tingle Statues (item funcs, owned checks, Tingle Island statue, Ankle reward)
PC_RANDO_SMOKE(bog, randoSmokeBog) // R3.13: the Ballad of Gales 10th warp to Forsaken Fortress, messages 848/704, isTbox_unloaded
PC_RANDO_SMOKE(wrap, randoSmokeWrap) // R3.20: word wrap with the real message font against gclib (fixture R3_20_wrap_font.txt)
PC_RANDO_SMOKE(menu, randoSmokeMenu) // R4.1: the Randomizer tab (presets, validation rules, starting gear)
PC_RANDO_SMOKE(event, randoSmokeEvent) // R0.11: the event_list.dat in-place patcher (Orichh Gp1_Get_Itm prm0 read back by dEvent_manager_c)
PC_RANDO_SMOKE(loc, randoSmokeLoc) // R2.1: locations T1 (patched records + live actors) and T2 (open a chest); chests for now
PC_RANDO_SMOKE(actr, randoSmokeActr) // R2.2: field items, pots, stone heads (T1 records and live actors, T2 item-get)
PC_RANDO_SMOKE(scob, randoSmokeScob) // R2.3: SCOB locations (salvage, Big Octo, Gunboat, dig spot), Needle Rock flags, salvage light and dig hunks
PC_RANDO_SMOKE(bossitem, randoSmokeBossitem) // R2.5: boss Heart Containers (Bitem, createItemForBoss, disappear cloud, item_func_utuwa_heart)
PC_RANDO_SMOKE(codeA, randoSmokeCodeA) // R2.6: code locations A (Great Fairies, Orca 500 hits, Tingle, Ankle, Ivan, Mrs. Marie)
PC_RANDO_SMOKE(windfall, randoSmokeWindfall) // R2.7: Windfall NPC code locations (item sites, event bits 0x6904-0x6A02, done-state probes)
PC_RANDO_SMOKE(ftree, randoSmokeFtree) // R2.8: the Withered Trees heart part as a placed item (custom_createItem, momentum, place, give)
PC_RANDO_SMOKE(codec, randoSmokeCodec) // R2.8: code locations C lookups (T1: auction, Battlesquid, Barrel Shooting, Bird-Man, Goron, mailbox, Withered Trees, Zunari, Doc Bandam)
PC_RANDO_SMOKE(shop, randoSmokeShop) // R2.9: Beedle shops (placed items in the shop lists, buying, the Bait Bag slot bit, uniqueness bit)
PC_RANDO_SMOKE(newgame, randoSmokeNewgame) // R3.1: new-game state (init_save_with_tweaks: items, counts, event bits, switches, chart)
PC_RANDO_SMOKE(keybag, randoSmokeKeybag) // R3.5: the key bag text (messages 403/603, stringSet tag cases 0x4B-0x4F)
PC_RANDO_SMOKE(stagesA, randoSmokeStagesA) // R3.15: stage tweaks A (FF2, GT warp, Makar, walls, boulders, ghost ship, TotG, eye reefs, Helmaroc table, fairy island, FF door dzb)
PC_RANDO_SMOKE(stagesB, randoSmokeStagesB) // R3.16: stage tweaks B (spawns 0 and 27, TagEv, FH warp, magic jars, hint sign; the player spawns at the booted point)
PC_RANDO_SMOKE(posttext, randoSmokePosttext) // R3.21: post-randomization texts (shops, auction, Battlesquid, letter, charts, KoRL, Beedle, swift sail) against wwrando
PC_RANDO_SMOKE(evloc, randoSmokeEvloc) // R2.4: the 11 event locations (T1 event_list.dat actions read back, T2 an event gives the placed item), Orca site, Hurricane Spin bit 0x6901
PC_RANDO_SMOKE(addchest, randoSmokeAddchest) // R2.10: the 4 added chests (records, live chests, T2 opening) and their room/event edits; vanilla by content hash
PC_RANDO_SMOKE(start, randoSmokeStart) // R3.2: rando-start (real new game with a pending seed: dock spawn 0, 3 hearts, sword, clothes, the boat at Outset; load/game-over/NG+ hunks)
PC_RANDO_SMOKE(evser, randoSmokeEvser) // R3.14: the event_list.dat serializer (every stage round-trips byte-identical; add event + action = wwrando; a grown file read by dEvent_manager_c)
PC_RANDO_SMOKE(zephos, randoSmokeZephos) // R3.19: Zephos (TACT_HT shortened, played to its end, only the placed item) and the auction intro (AUCTION_START)
PC_RANDO_SMOKE(pirateship, randoSmokePirateship) // R3.17: the pirate ship at Windfall (the ship on sea/Room11; Asoko: Aryll, AryllOpensDoor when trapped, door switch 0xC4, messages, voice wave)
PC_RANDO_SMOKE(totg, randoSmokeTotg) // R3.18: Tower of the Gods servants (files = wwrando's, the loaded events and SwOps, servant switches in any order -> hsehi1_appear, 0x7E, then 0x2B -> 0x7F)
PC_RANDO_SMOKE(trap, randoSmokeTrap) // R6.5: a trap chest (plan, params 0x40 and chest type, wwrando's DEFAULT_TREASURE_TRAP; opened: freeze, thaw, 2 damage, no item)
PC_RANDO_SMOKE(gen, randoSmokeGen) // R4.3: Generate in the menu (worker thread, pending seed with its hash, sidecar in the card folder, D5 logs in the user dir)
PC_RANDO_SMOKE(swordless, randoSmokeSwordless) // R6.3: Swordless (temporary Hero's Sword at GTower and Ojhous, removed at the next load; messages 1128/1590)
PC_RANDO_SMOKE(extrastart, randoSmokeExtrastart) // R6.4: extra starting items, starting Pieces of Heart and Triforce Shards in a new game (hearts, shards, gear)
